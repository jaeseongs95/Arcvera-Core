{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContextBaseInstructions": {
      "properties": {
        "placement": {
          "$ref": "#/definitions/ContextBasePlacement"
        },
        "utf8Bytes": {
          "description": "Configured instructions length; not a count of a normalized request field.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "placement",
        "utf8Bytes"
      ],
      "type": "object"
    },
    "ContextBasePlacement": {
      "enum": [
        "history",
        "outsideHistory"
      ],
      "type": "string"
    },
    "ContextItemCounts": {
      "properties": {
        "agentMessages": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "compaction": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "configuration": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "messages": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "other": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "reasoning": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "toolCalls": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "toolDeclarations": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "toolOutputs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "agentMessages",
        "compaction",
        "configuration",
        "messages",
        "other",
        "reasoning",
        "toolCalls",
        "toolDeclarations",
        "toolOutputs"
      ],
      "type": "object"
    },
    "ContextMeasurementStatus": {
      "enum": [
        "unverified",
        "notCaptured"
      ],
      "type": "string"
    },
    "ContextMessageSourceCounts": {
      "description": "Positional sources of Message/AgentMessage parts; roles do not identify sources.",
      "properties": {
        "agentsMd": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "developerInstructions": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "harness": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "hooks": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skills": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "tool": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "unknown": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "user": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "agentsMd",
        "developerInstructions",
        "harness",
        "hooks",
        "skills",
        "tool",
        "unknown",
        "user"
      ],
      "type": "object"
    },
    "ContextRoleCounts": {
      "properties": {
        "assistant": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "developer": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "other": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "system": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "user": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "assistant",
        "developer",
        "other",
        "system",
        "user"
      ],
      "type": "object"
    },
    "ContextSnapshotScope": {
      "enum": [
        "retainedLocalHistory"
      ],
      "type": "string"
    },
    "ThreadContextSnapshot": {
      "description": "Never contains prompt text, tool arguments, paths or arbitrary metadata strings.",
      "properties": {
        "baseInstructions": {
          "$ref": "#/definitions/ContextBaseInstructions"
        },
        "historyRevision": {
          "description": "Destructive-history revision; this is not an append sequence or a timestamp.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "itemCount": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "items": {
          "$ref": "#/definitions/ContextItemCounts"
        },
        "messageSources": {
          "$ref": "#/definitions/ContextMessageSourceCounts"
        },
        "nextRequestTools": {
          "$ref": "#/definitions/ContextMeasurementStatus"
        },
        "roles": {
          "$ref": "#/definitions/ContextRoleCounts"
        },
        "scope": {
          "$ref": "#/definitions/ContextSnapshotScope"
        },
        "serverMeasuredUsage": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "trackedUsage": {
          "anyOf": [
            {
              "$ref": "#/definitions/TokenUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Existing tracking can contain synthetic counts; not certified server usage."
        },
        "trackedUsageProvenance": {
          "$ref": "#/definitions/ContextMeasurementStatus"
        },
        "windowNumber": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "baseInstructions",
        "historyRevision",
        "itemCount",
        "items",
        "messageSources",
        "nextRequestTools",
        "roles",
        "scope",
        "trackedUsageProvenance",
        "windowNumber"
      ],
      "type": "object"
    },
    "TokenUsage": {
      "properties": {
        "cache_write_input_tokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cached_input_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "input_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "output_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "total_tokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cached_input_tokens",
        "input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "snapshot": {
      "$ref": "#/definitions/ThreadContextSnapshot"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "snapshot",
    "threadId"
  ],
  "title": "ThreadContextReadResponse",
  "type": "object"
}