    "/api/v1/conversations/{conversationId}/events": {
      "get": {
        "operationId": "openEvents",
        "description": "Cursor from snapshot or Last-Event-ID; never both. Durable SSE id is streamEpoch:sequence. Transient/control frames have no SSE id. Replay gap returns 410 Problem before stream or SNAPSHOT_REQUIRED during stream.",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "streamEpoch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
              "description": "Non-negative decimal int64; never a floating-point counter."
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          },
          {
            "$ref": "#/components/parameters/DisplayTimeZone"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded stream; Content-Type text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "events.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure; HTTP success is never substituted.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "schemas.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CoreBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Core-issued local credential read by trusted Desktop process; never vendor OAuth or legacy CLI config."
      }
    },
    "parameters": {
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "description": "RFC language priority list; invalid syntax returns INVALID_REQUEST. Valid unsupported language negotiates the default.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "DisplayTimeZone": {
        "name": "X-Arcvera-Time-Zone",
        "in": "header",
        "required": false,
        "description": "Valid IANA ZoneId or UTC; invalid ID returns INVALID_REQUEST. Affects display only, never storage or wire timestamps.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}
