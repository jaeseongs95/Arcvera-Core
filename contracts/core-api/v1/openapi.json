    "title": "Arcvera Core / Desktop draft contract",
    "version": "0.2.0",
    "description": "Internal P0 draft. Routes and schemas are proposed; no implementation or capability support is implied."
  },
  "x-contract-status": "DRAFT",
  "servers": [
    {
      "url": "/",
      "description": "Resolve only against the numeric loopback origin from the verified Core connection descriptor. No default port is assumed."
    }
  ],
