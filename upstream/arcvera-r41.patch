+            r#"{"committed":true,"revision":1}"#,
+            false,
+        ),
+        (
+            "context_index",
+            r#"{"action":"apply"}"#,
+            r#"{"committed":false,"revision":1}"#,
+            true,
+        ),
+        (
+            "context_index",
+            r#"{"action":"apply"}"#,
+            r#"{"committed":true}"#,
+            true,
