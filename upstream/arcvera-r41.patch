+        task_id: id.to_owned(),
+        label: id.to_owned(),
+    }
+}
+
+fn bind(task: &str, source: &str) -> ContextIndexOperation {
+    ContextIndexOperation::BindSources {
+        task_id: task.to_owned(),
+        source_ids: vec![source.to_owned()],
+    }
