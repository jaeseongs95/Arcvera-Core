+        assert_eq!(
+            (sizes.history_version, sizes.context_index_revision),
+            (9, 7)
+        );
+        assert_eq!(sizes.scope, "prepared_sampling_prompt");
+        let encoded = serde_json::to_string(&page).unwrap();
+        for sentinel in [
