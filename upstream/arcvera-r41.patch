-                ),
-                ProstCodec::<ResumeRequest, wire::ResumeResponse>::default(),
-            ),
-        )
-        .await
-        .map_err(|_| Error::Timeout)?
-        .map_err(Error::from)?;
-        Ok(())
-    }
