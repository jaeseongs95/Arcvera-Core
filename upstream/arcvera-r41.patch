-        work.set((hashes + 1, ordinals));
-    });
-    let mut writer = HashWriter::new(HASH_STATE.get_or_init(RandomState::new).build_hasher());
-    match serde_json::to_writer(&mut writer, value) {
-        Ok(()) => writer.finish(),
-        Err(_) => Fingerprint {
-            hash: None,
-            bytes: writer.bytes,
-        },
-    }
-}
