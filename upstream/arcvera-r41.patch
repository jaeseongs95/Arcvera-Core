+                    task_id: "live".to_owned(),
+                    source_ids: vec!["msg_live".to_owned()],
+                },
+                ContextIndexOperation::SetTaskState {
+                    task_id: "done".to_owned(),
+                    state: codex_history::context_index::ContextTaskState::Completed,
+                },
+                ContextIndexOperation::SetFocus {
+                    task_id: "live".to_owned(),
+                },
+            ],
