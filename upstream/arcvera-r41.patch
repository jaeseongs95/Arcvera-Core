+fn original_source_item(suffix: &str, text: &str) -> ResponseItem {
+    let RolloutItem::ResponseItem(mut envelope) = user_message(text) else {
+        unreachable!();
+    };
+    envelope
+        .item
+        .set_id(Some(codex_protocol::ResponseItemId::with_suffix(
+            "msg", suffix,
+        )));
+    envelope.item
