+// Modified for Arcvera-Core R41 (2026-11-11); see MODIFICATIONS.md.
+//! Response-level cache observations. They never determine context relevance, authorization,
+//! retention of original history, or whether an individual source was cached.
+use super::session::Session;
+use crate::state::SessionState;
+use chrono::SecondsFormat;
+use chrono::Utc;
+use codex_protocol::ResponseUsageMetadata;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum CacheStatus {
+    Hit,
+    Miss,
+    Unknown,
+    Invalid,
+}
+
+/// Deliberately stores only a numeric usage observation, time and request revision. Raw usage,
+/// cache keys, response bodies, source identities and tokens are never copied into this state.
+pub(crate) struct ContextCacheObservation {
+    status: CacheStatus,
+    cached_input_tokens: Option<u64>,
+    observed_at: String,
+    request_context_index_revision: Option<u64>,
+}
+
+impl ContextCacheObservation {
+    fn from_usage(
+        usage: Option<&ResponseUsageMetadata>,
+        request_context_index_revision: Option<u64>,
+        observed_at: String,
+    ) -> Self {
+        let (status, cached_input_tokens) =
+            cache_counter(usage.and_then(|usage| usage.metadata.as_ref()));
+        Self {
+            status,
+            cached_input_tokens,
+            observed_at,
+            request_context_index_revision,
+        }
+    }
+}
+
+fn cache_counter(raw_usage: Option<&Value>) -> (CacheStatus, Option<u64>) {
+    let raw_usage = match raw_usage {
+        None | Some(Value::Null) => return (CacheStatus::Unknown, None),
+        Some(Value::Object(usage)) => usage,
+        Some(_) => return (CacheStatus::Invalid, None),
+    };
+    let details = match raw_usage.get("input_tokens_details") {
+        None | Some(Value::Null) => return (CacheStatus::Unknown, None),
+        Some(Value::Object(details)) => details,
+        Some(_) => return (CacheStatus::Invalid, None),
+    };
+    let cached = match details.get("cached_tokens") {
+        None | Some(Value::Null) => return (CacheStatus::Unknown, None),
+        Some(value) => match value.as_u64() {
+            Some(cached) => cached,
+            None => return (CacheStatus::Invalid, None),
+        },
+    };
+    if let Some(input) = raw_usage
+        .get("input_tokens")
+        .filter(|input| !input.is_null())
+    {
+        match input.as_u64() {
+            Some(input) if cached <= input => {}
+            _ => return (CacheStatus::Invalid, None),
+        }
+    }
+    (
+        if cached == 0 {
+            CacheStatus::Miss
+        } else {
+            CacheStatus::Hit
+        },
+        Some(cached),
+    )
+}
+
+impl SessionState {
+    /// The caller can include this in the same locked snapshot as context_index list metadata.
+    pub(crate) fn context_cache_metadata(&self) -> Value {
+        let current_revision = self.history.context_index_revision();
+        let observation = self.latest_context_cache.as_ref();
+        let request_revision = observation.and_then(|value| value.request_context_index_revision);
+        let revision_status = match request_revision {
+            Some(revision) if revision == current_revision => "current",
+            Some(_) => "stale",
+            None => "unknown",
+        };
+        json!({
+            "scope": "response",
+            "request_kind": "sampling",
+            "status": observation.map_or(CacheStatus::Unknown, |value| value.status),
+            "cached_input_tokens": observation.and_then(|value| value.cached_input_tokens),
+            "evidence": "reported_response_usage_counter_only",
+            "observed_at": observation.map(|value| value.observed_at.as_str()),
+            "observation_time_basis": "host_sampling_completed_event",
+            "request_context_index_revision": request_revision,
+            "current_context_index_revision": current_revision,
+            "revision_status": revision_status,
+            "source_cache_attribution": "not_reported",
+            "retention": {"status": "unknown", "provenance": "not_provided", "duration_seconds": null},
+            "expiry": {"status": "unknown", "provenance": "not_provided", "expires_at": null},
+            "coverage": {
+                "sampling": if observation.is_some() { "latest_completed_response" } else { "not_observed" },
+                "compaction": "not_observed",
+                "prewarm": "not_observed"
+            }
+        })
+    }
+}
+
+impl Session {
+    pub(crate) async fn record_context_cache_metadata(
+        &self,
+        usage: Option<&ResponseUsageMetadata>,
+        request_context_index_revision: Option<u64>,
+    ) {
+        let observation = ContextCacheObservation::from_usage(
+            usage,
+            request_context_index_revision,
+            Utc::now().to_rfc3339_opts(SecondsFormat::Millis, true),
+        );
+        self.state.lock().await.latest_context_cache = Some(observation);
+    }
+
+    pub(crate) async fn context_cache_metadata(&self) -> Value {
+        self.state.lock().await.context_cache_metadata()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::tests::make_session_and_context;
+    use codex_attachment_store::InlineAttachmentStore;
+    use codex_history::context_index::ContextIndexOperation;
+    use codex_history::context_index::ContextTaskState;
+    use codex_protocol::ResponseItemId;
+    use codex_protocol::models::ContentItem;
+    use codex_protocol::models::ResponseItem;
+    use codex_protocol::openai_models::InputModality;
+
+    fn usage(raw: Value) -> ResponseUsageMetadata {
+        ResponseUsageMetadata {
+            amount: None,
+            metadata: Some(raw),
+        }
+    }
+
+    fn observation(raw: Option<Value>) -> ContextCacheObservation {
+        ContextCacheObservation::from_usage(
+            raw.map(usage).as_ref(),
+            Some(0),
+            "2026-11-10T00:00:00.000Z".to_string(),
+        )
+    }
+
+    #[test]
+    fn context_cache_missing_and_null_are_unknown_but_explicit_zero_is_miss() {
+        for raw in [
+            None,
+            Some(Value::Null),
+            Some(json!({})),
+            Some(json!({"input_tokens_details":null})),
+            Some(json!({"input_tokens_details":{}})),
+            Some(json!({"input_tokens_details":{"cached_tokens":null}})),
+        ] {
+            let result = observation(raw);
+            assert_eq!(result.status, CacheStatus::Unknown);
+            assert_eq!(result.cached_input_tokens, None);
+        }
+        let result = observation(Some(
+            json!({"input_tokens":100,"input_tokens_details":{"cached_tokens":0}}),
+        ));
+        assert_eq!(result.status, CacheStatus::Miss);
+        assert_eq!(result.cached_input_tokens, Some(0));
+    }
+
+    #[test]
+    fn context_cache_positive_counter_is_hit_with_exact_reported_count() {
+        let result = observation(Some(
+            json!({"input_tokens":100,"input_tokens_details":{"cached_tokens":64}}),
+        ));
+        assert_eq!(result.status, CacheStatus::Hit);
+        assert_eq!(result.cached_input_tokens, Some(64));
+    }
+
+    #[test]
+    fn context_cache_invalid_containers_and_counters_are_not_hits() {
+        for raw in [
+            json!([]),
+            json!("body"),
+            json!({"input_tokens_details":[]}),
+            json!({"input_tokens_details":{"cached_tokens":-1}}),
+            json!({"input_tokens_details":{"cached_tokens":1.5}}),
+            json!({"input_tokens_details":{"cached_tokens":"64"}}),
+            json!({"input_tokens":10,"input_tokens_details":{"cached_tokens":11}}),
+            json!({"input_tokens":"100","input_tokens_details":{"cached_tokens":64}}),
+        ] {
+            let result = observation(Some(raw));
+            assert_eq!(result.status, CacheStatus::Invalid);
+            assert_eq!(result.cached_input_tokens, None);
+        }
+    }
+
+    #[tokio::test]
+    async fn context_cache_expiry_unknown_and_no_source_or_private_metadata_copied() {
+        let (session, _turn) = make_session_and_context().await;
+        let raw = usage(json!({
+            "input_tokens":100,"input_tokens_details":{"cached_tokens":64},
+            "prompt_cache_key":"PRIVATE_CACHE_KEY_d68a", "body":"PRIVATE_BODY_e573",
+            "cache_ttl_seconds":3600, "expires_at":"PRIVATE_EXPIRY_c549",
+            "sources":[{"id":"PRIVATE_SOURCE_b92a","cached":true}]
+        }));
+        session
+            .record_context_cache_metadata(Some(&raw), Some(0))
+            .await;
+        let metadata = session.context_cache_metadata().await;
+        assert_eq!(metadata["scope"], json!("response"));
+        assert_eq!(metadata["status"], json!("hit"));
+        assert_eq!(metadata["source_cache_attribution"], json!("not_reported"));
+        assert_eq!(
+            metadata["retention"],
+            json!({"status":"unknown","provenance":"not_provided","duration_seconds":null})
+        );
+        assert_eq!(
+            metadata["expiry"],
+            json!({"status":"unknown","provenance":"not_provided","expires_at":null})
+        );
+        assert_eq!(metadata["coverage"]["compaction"], json!("not_observed"));
+        assert_eq!(metadata["coverage"]["prewarm"], json!("not_observed"));
+        let encoded = metadata.to_string();
+        for forbidden in [
+            "PRIVATE_CACHE_KEY_d68a",
+            "PRIVATE_BODY_e573",
+            "PRIVATE_EXPIRY_c549",
+            "PRIVATE_SOURCE_b92a",
+            "3600",
+        ] {
+            assert!(
+                !encoded.contains(forbidden),
+                "private or unsupported value copied: {forbidden}"
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn context_cache_late_response_retains_request_revision_and_is_stale() {
+        let (session, _turn) = make_session_and_context().await;
+        // Request left with revision 0. The policy changes before its completed response arrives.
+        session
+            .state
+            .lock()
+            .await
+            .history
+            .apply_context_index(
+                0,
+                vec![ContextIndexOperation::CreateTask {
+                    task_id: "new-policy".to_string(),
+                    label: "New policy".to_string(),
+                }],
+            )
+            .expect("policy change");
+        let raw = usage(json!({"input_tokens_details":{"cached_tokens":5}}));
+        session
+            .record_context_cache_metadata(Some(&raw), Some(0))
+            .await;
+        let metadata = session.context_cache_metadata().await;
+        assert_eq!(metadata["request_context_index_revision"], json!(0));
+        assert_eq!(metadata["current_context_index_revision"], json!(1));
+        assert_eq!(metadata["revision_status"], json!("stale"));
+        session
+            .record_context_cache_metadata(Some(&raw), None)
+            .await;
+        let unbound = session.context_cache_metadata().await;
+        assert_eq!(unbound["request_context_index_revision"], Value::Null);
+        assert_eq!(unbound["revision_status"], json!("unknown"));
+    }
+
+    #[tokio::test]
+    async fn context_cache_is_thread_local_and_does_not_change_prepared_model_prompt() {
+        let (session, turn) = make_session_and_context().await;
+        let item = ResponseItem::Message {
+            id: Some(ResponseItemId::with_suffix("msg", "cache-prompt-original")),
+            role: "assistant".to_string(),
+            content: vec![ContentItem::OutputText {
+                text: "EXCLUDED_CACHE_PROMPT_ORIGINAL_c02e".to_string(),
+                annotations: None,
+                logprobs: None,
+            }],
+            status: None,
+            encrypted_content: None,
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        };
+        session
+            .record_conversation_items(&turn, turn.model_info(), &[item])
+            .await;
+        session
+            .state
+            .lock()
+            .await
+            .history
+            .apply_context_index(
+                0,
+                vec![
+                    ContextIndexOperation::CreateTask {
+                        task_id: "completed".to_string(),
+                        label: "Completed cache fixture".to_string(),
+                    },
+                    ContextIndexOperation::BindSources {
+                        task_id: "completed".to_string(),
+                        source_ids: vec!["msg_cache-prompt-original".to_string()],
+                    },
+                    ContextIndexOperation::SetTaskState {
+                        task_id: "completed".to_string(),
+                        state: ContextTaskState::Completed,
+                    },
+                ],
+            )
+            .expect("excluded source creates navigation manifest");
+        let before = session
+            .clone_history()
+            .await
+            .projected_for_prompt(&[InputModality::Text], &InlineAttachmentStore)
+            .await;
+        assert!(
+            !before.is_empty(),
+            "navigation manifest must exercise the actual prompt path"
+        );
+        assert!(
+            !serde_json::to_string(&before)
+                .expect("prepared JSON")
+                .contains("EXCLUDED_CACHE_PROMPT_ORIGINAL_c02e")
+        );
+        let raw = usage(json!({"input_tokens_details":{"cached_tokens":5}}));
+        session
+            .record_context_cache_metadata(Some(&raw), Some(1))
+            .await;
+        let after = session
+            .clone_history()
+            .await
+            .projected_for_prompt(&[InputModality::Text], &InlineAttachmentStore)
+            .await;
+        assert_eq!(before, after);
+        let metadata = session.context_cache_metadata().await;
+        assert_eq!(metadata["revision_status"], json!("current"));
+        assert!(metadata["observed_at"].as_str().is_some());
+        let (other, _turn) = make_session_and_context().await;
+        let other_metadata = other.context_cache_metadata().await;
+        assert_eq!(other_metadata["status"], json!("unknown"));
+        assert_eq!(other_metadata["observed_at"], Value::Null);
+        assert_eq!(other_metadata["cached_input_tokens"], Value::Null);
+        assert_eq!(
+            other_metadata["coverage"]["sampling"],
+            json!("not_observed")
+        );
+    }
+
+    #[tokio::test]
+    async fn context_cache_missing_completed_usage_replaces_previous_hit_with_unknown() {
+        let (session, _turn) = make_session_and_context().await;
+        let raw = usage(json!({"input_tokens_details":{"cached_tokens":5}}));
+        session
+            .record_context_cache_metadata(Some(&raw), Some(0))
+            .await;
+        session.record_context_cache_metadata(None, Some(0)).await;
+        let metadata = session.context_cache_metadata().await;
+        assert_eq!(metadata["status"], json!("unknown"));
+        assert_eq!(metadata["cached_input_tokens"], Value::Null);
+        assert_eq!(
+            metadata["coverage"]["sampling"],
+            json!("latest_completed_response")
+        );
+    }
+}
diff --git a/codex-rs/core/src/session/indexed_context.rs b/codex-rs/core/src/session/indexed_context.rs
new file mode 100644
index 0000000000000000000000000000000000000000..74b0977a9b0d5201fc036178716fada0a5829a4d
--- /dev/null
+++ b/codex-rs/core/src/session/indexed_context.rs
@@ -0,0 +1,356 @@
+// Modified for Arcvera-Core R41 (2026-11-11); see MODIFICATIONS.md.
+//! Current-thread indexed context operations. Policy commits use the checkpoint persistence
+//! permit; conversation bodies remain in the existing thread store, never in this index.
+use super::*;
+use crate::function_tool::FunctionCallError;
+use codex_history::context_index::ContextIndex;
+use codex_history::context_index::ContextIndexOperation;
+use futures::FutureExt;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+
+#[derive(Debug, Deserialize)]
+#[serde(tag = "action", rename_all = "snake_case", deny_unknown_fields)]
+enum IndexRequest {
+    List {
+        #[serde(default)]
+        cursor: usize,
+        limit: Option<usize>,
+        #[serde(default)]
+        include_unrelated: bool,
+    },
+    Read {
+        source_id: String,
+        #[serde(default)]
+        offset: usize,
+        max_bytes: Option<usize>,
+    },
+    Apply {
+        expected_revision: u64,
+        operations: Vec<ContextIndexOperation>,
+    },
+    Audit {
+        #[serde(default)]
+        cursor: usize,
+        limit: Option<usize>,
+        revision: Option<u64>,
+        #[serde(default)]
+        offset: usize,
+        max_bytes: Option<usize>,
+    },
+}
+
+fn failure(message: impl Into<String>) -> FunctionCallError {
+    FunctionCallError::RespondToModel(message.into())
+}
+
+fn unique_original_source<'a>(
+    items: impl Iterator<Item = &'a ResponseItem>,
+    source_id: &str,
+) -> Result<Option<ResponseItem>, FunctionCallError> {
+    let mut original = None;
+    for item in items.filter(|item| ContextIndex::source_id(item).as_deref() == Some(source_id)) {
+        if let Some(previous) = original {
+            if previous != item {
+                return Err(failure("ambiguous original source in the current thread"));
+            }
+        } else {
+            original = Some(item);
+        }
+    }
+    Ok(original.cloned())
+}
+
+fn page_limit(limit: Option<usize>) -> Result<usize, FunctionCallError> {
+    let limit = limit.unwrap_or(25);
+    if !(1..=100).contains(&limit) {
+        return Err(failure("limit must be in 1..100"));
+    }
+    Ok(limit)
+}
+
+fn bounded_response(value: Value) -> Result<Value, FunctionCallError> {
+    if value.to_string().len() > 65_536 {
+        return Err(failure(
+            "context index response exceeds 65536 bytes; request a smaller limit",
+        ));
+    }
+    Ok(value)
+}
+
+impl Session {
+    pub(crate) async fn ensure_context_index_ready(&self) -> CodexResult<()> {
+        if let Some(error) = &self.state.lock().await.context_index_error {
+            return Err(CodexErr::InvalidRequest(format!(
+                "Context index requires cold resume before continuing: {error}"
+            )));
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn context_index_action(
+        self: &Arc<Self>,
+        _turn: &TurnContext,
+        arguments: &str,
+    ) -> Result<Value, FunctionCallError> {
+        if arguments.len() > 65_536 {
+            return Err(failure("context index request exceeds 65536 bytes"));
+        }
+        let request: IndexRequest = serde_json::from_str(arguments)
+            .map_err(|error| failure(format!("invalid context_index arguments: {error}")))?;
+        match request {
+            IndexRequest::List {
+                cursor,
+                limit,
+                include_unrelated,
+            } => {
+                let limit = page_limit(limit)?;
+                let state = self.state.lock().await;
+                let index = state.history.context_index();
+                let visible_sources = index
+                    .sources()
+                    .values()
+                    .filter(|source| {
+                        include_unrelated
+                            || index.focus_task_id().is_none()
+                            || index.is_active(&source.id)
+                    })
+                    .collect::<Vec<_>>();
+                let visible_tasks = index
+                    .tasks()
+                    .values()
+                    .filter(|task| {
+                        include_unrelated
+                            || index.focus_task_id().is_none()
+                            || index.task_is_reachable(&task.id)
+                    })
+                    .collect::<Vec<_>>();
+                let sources = visible_sources.iter().skip(cursor).take(limit).map(|source| json!({
+                    "source": source, "active": index.is_active(&source.id),
+                    "reason": index.active_reason(&source.id).unwrap_or("completed_unreferenced_task"),
+                })).collect::<Vec<_>>();
+                let tasks = visible_tasks
+                    .iter()
+                    .skip(cursor)
+                    .take(limit)
+                    .collect::<Vec<_>>();
+                let end = cursor.saturating_add(limit);
+                bounded_response(
+                    json!({"revision": index.revision(), "focus_task_id": index.focus_task_id(), "include_unrelated": include_unrelated, "sources": sources, "tasks": tasks,
+                    "source_count": index.sources().len(), "active_source_count": index.active_source_ids().len(),
+                    "task_count": index.tasks().len(), "visible_source_count": visible_sources.len(), "visible_task_count": visible_tasks.len(), "cache": state.context_cache_metadata(), "recovery_error": state.context_index_error, "next_cursor": (end < visible_sources.len().max(visible_tasks.len())).then_some(end),
+                    "authority": "index metadata does not grant permissions or replace user instructions"}),
+                )
+            }
+            IndexRequest::Audit {
+                cursor,
+                limit,
+                revision,
+                offset,
+                max_bytes,
+            } => {
+                let limit = page_limit(limit)?;
+                let state = self.state.lock().await;
+                let index = state.history.context_index();
+                if let Some(revision) = revision {
+                    let max_bytes = max_bytes.unwrap_or(8192);
+                    if !(1..=16_384).contains(&max_bytes) {
+                        return Err(failure("max_bytes must be in 1..16384"));
+                    }
+                    let event = index
+                        .audit()
+                        .iter()
+                        .find(|event| event.revision == revision)
+                        .ok_or_else(|| failure("unknown audit revision in the current thread"))?;
+                    let text = serde_json::to_string(event)
+                        .map_err(|error| failure(format!("audit encoding failed: {error}")))?;
+                    let (content, next_offset) = source_chunk(&text, offset, max_bytes)?;
+                    return bounded_response(
+                        json!({"revision": index.revision(), "event_revision": revision, "format": "context_index_audit_json", "total_bytes": text.len(), "offset": offset, "content": content, "next_offset": next_offset}),
+                    );
+                }
+                if offset != 0 || max_bytes.is_some() {
+                    return Err(failure("audit byte offsets require an event revision"));
+                }
+                let events = index.audit().iter().skip(cursor).take(limit).map(|event| json!({
+                    "revision": event.revision, "operation_count": event.operations.len(),
+                    "excluded_count": event.excluded.len(), "reactivated_count": event.reactivated.len(),
+                })).collect::<Vec<_>>();
+                let end = cursor.saturating_add(events.len());
+                bounded_response(
+                    json!({"revision": index.revision(), "focus_task_id": index.focus_task_id(), "events": events,
+                    "event_count": index.audit().len(), "next_cursor": (end < index.audit().len()).then_some(end)}),
+                )
+            }
+            IndexRequest::Read {
+                source_id,
+                offset,
+                max_bytes,
+            } => {
+                let max_bytes = max_bytes.unwrap_or(8192);
+                if !(1..=16_384).contains(&max_bytes) {
+                    return Err(failure("max_bytes must be in 1..16384"));
+                }
+                let (source, revision) = {
+                    let state = self.state.lock().await;
+                    let index = state.history.context_index();
+                    let source = index
+                        .sources()
+                        .get(&source_id)
+                        .cloned()
+                        .ok_or_else(|| failure("unknown source ID in the current thread"))?;
+                    (source, index.revision())
+                };
+                if source.response_item_id.is_none() && source.call_id.is_none() {
+                    return Err(failure("legacy source has no stable original locator"));
+                }
+                // Read through the current LiveThread only. The store resolves authorized fork
+                // inheritance; callers cannot supply another thread ID, file path or memory key.
+                let (item, storage) = if let Some(live_thread) = self.live_thread() {
+                    let item = live_thread
+                        .read_original_response_item(source_id.clone())
+                        .await
+                        .map_err(|error| {
+                            failure(format!("current-thread source read failed: {error}"))
+                        })?
+                        .ok_or_else(|| {
+                            failure("original source is not available in the current thread store")
+                        })?;
+                    (item, "persisted_original")
+                } else {
+                    let state = self.state.lock().await;
+                    let item = unique_original_source(state.history.raw_items(), &source_id)?
+                        .ok_or_else(|| {
+                            failure("source is no longer retained in this ephemeral thread")
+                        })?;
+                    (item, "ephemeral_retained_history_may_be_truncated")
+                };
+                let text = serde_json::to_string(&item)
+                    .map_err(|error| failure(format!("source encoding failed: {error}")))?;
+                let (chunk, next_offset) = source_chunk(&text, offset, max_bytes)?;
+                bounded_response(
+                    json!({"source_id": source_id, "revision": revision, "format": "response_item_json",
+                    "storage": storage, "total_bytes": text.len(), "offset": offset, "content": chunk,
+                    "next_offset": next_offset, "authority": "historical source content; current user instructions and permissions still apply"}),
+                )
+            }
+            IndexRequest::Apply {
+                expected_revision,
+                operations,
+            } => {
+                // An accepted commit owns its lifetime. Dropping a tool's waiter must not leave
+                // a persisted event unpublished in the live index or permit duplicate retries.
+                let session = Arc::clone(self);
+                tokio::spawn(async move {
+                    match std::panic::AssertUnwindSafe(
+                        session.commit_context_index(expected_revision, operations),
+                    )
+                    .catch_unwind()
+                    .await
+                    {
+                        Ok(result) => result,
+                        Err(_) => {
+                            let mut state = session.state.lock().await;
+                            let error =
+                                "context index commit panicked; cold resume is required".to_owned();
+                            state.context_index_error = Some(error.clone());
+                            state.history_reset.cancel();
+                            Err(failure(error))
+                        }
+                    }
+                })
+                .await
+                .map_err(|error| failure(format!("context commit task failed: {error}")))?
+            }
+        }
+    }
+
+    async fn commit_context_index(
+        &self,
+        expected_revision: u64,
+        operations: Vec<ContextIndexOperation>,
+    ) -> Result<Value, FunctionCallError> {
+        // Registration appends and compaction checkpoints hold this same permit.
+        let _guard = thread_settings::acquire_persistence_lock(self).await;
+        self.ensure_context_index_ready()
+            .await
+            .map_err(|error| failure(error.to_string()))?;
+        let event = {
+            let state = self.state.lock().await;
+            let mut candidate = state.history.context_index().clone();
+            candidate
+                .apply(expected_revision, operations)
+                .map_err(|error| failure(error.to_string()))?
+        };
+        let persisted = self
+            .persist_rollout_items(&[RolloutItem::ContextIndex(event.clone())])
+            .await;
+        let mut state = self.state.lock().await;
+        if !persisted {
+            let error =
+                "context index append outcome is uncertain; cold resume is required".to_owned();
+            state.context_index_error = Some(error.clone());
+            state.history_reset.cancel();
+            return Err(failure(error));
+        }
+        if let Err(error) = state.history.replay_context_index(&event) {
+            let error = format!(
+                "persisted context event could not be published: {error}; cold resume is required"
+            );
+            state.context_index_error = Some(error.clone());
+            state.history_reset.cancel();
+            return Err(failure(error));
+        }
+        let index = state.history.context_index();
+        // Keep the acknowledgement bounded even for a large valid operation batch. Full changes
+        // and exclusion reasons are available through paginated list/audit reads.
+        Ok(json!({"revision": index.revision(), "committed": true,
+            "source_count": index.sources().len(), "active_source_count": index.active_source_ids().len(),
+            "excluded_count": index.audit().last().map_or(0, |event| event.excluded.len()),
+            "reactivated_count": index.audit().last().map_or(0, |event| event.reactivated.len())}))
+    }
+}
+
+fn source_chunk(
+    text: &str,
+    offset: usize,
+    max_bytes: usize,
+) -> Result<(&str, Option<usize>), FunctionCallError> {
+    if offset > text.len() || !text.is_char_boundary(offset) {
+        return Err(failure("offset must be a UTF-8 boundary within the source"));
+    }
+    let mut end = offset.saturating_add(max_bytes).min(text.len());
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    if end == offset && offset < text.len() {
+        return Err(failure(
+            "max_bytes is too small for the next UTF-8 character",
+        ));
+    }
+    Ok((&text[offset..end], (end < text.len()).then_some(end)))
+}
+
+#[cfg(test)]
+mod chunk_tests {
+    use super::source_chunk;
+
+    #[test]
+    fn context_index_chunks_preserve_utf8_and_reject_impossible_offsets() {
+        let text = "a한🦀z";
+        assert_eq!(
+            source_chunk(text, 0, 4).expect("valid chunk"),
+            ("a한", Some(4))
+        );
+        assert_eq!(
+            source_chunk(text, 4, 4).expect("valid emoji"),
+            ("🦀", Some(8))
+        );
+        assert_eq!(source_chunk(text, 8, 4).expect("last chunk"), ("z", None));
+        assert_eq!(source_chunk(text, text.len(), 4).expect("end"), ("", None));
+        assert!(source_chunk(text, 2, 4).is_err());
+        assert!(source_chunk(text, 4, 3).is_err());
+        assert!(source_chunk(text, 10, 4).is_err());
+    }
+}
