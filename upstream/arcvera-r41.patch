+    let base = session.get_config().await;
+    assert!(!base.mcp_servers.get().contains_key("codex_tui"));
+    let projected = overlay.project(&base).unwrap();
+    assert_eq!(
+        projected.mcp_servers.get().get("codex_tui"),
+        b.get("codex_tui")
+    );
