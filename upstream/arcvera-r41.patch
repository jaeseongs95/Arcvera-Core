+async fn subscribed_loaded_thread_rebinds_runtime_mcp_after_owner_disconnect(
+    same_bridge: bool,
+) -> Result<()> {
+    use super::connection_handling_websocket as websocket;
+    use axum::body::Body;
+    use axum::extract::State;
