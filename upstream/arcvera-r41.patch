+fn percentile(samples: &[u128], percentile: usize) -> u128 {
+    let mut ordered = samples.to_vec();
+    ordered.sort_unstable();
+    ordered[(ordered.len() * percentile).div_ceil(100).saturating_sub(1)]
+}
