+    def triple(self):
+        binaries = {}
+        for name, filename in (("cli", "codex.exe"), ("app-server", "codex-app-server.exe"),
+                               ("code-mode-host", "codex-code-mode-host.exe")):
+            target = self.root / "candidate" / filename
+            target.parent.mkdir(exist_ok=True)
