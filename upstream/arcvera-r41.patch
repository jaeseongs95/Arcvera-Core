+            "OPERATION_CONFLICT",
+            "REQUEST_EXPIRED",
+            "BUSY",
+            "OUTCOME_UNRESOLVED",
+            "CAPABILITY_UNSUPPORTED",
+            "CURSOR_GAP",
+            "SCHEMA_MISMATCH",
+            "LEASE_REQUIRED",
+            "LEASE_CONFLICT",
+            "APPROVAL_STALE",
+            "INTERNAL_ERROR",
+            "SNAPSHOT_LIMIT_EXCEEDED"
+          ]
+        },
+        "correlationId": {
+          "type": "string",
+          "format": "uuid"
+        },
+        "retryAfterSeconds": {
+          "anyOf": [
+            {
+              "type": "integer",
+              "minimum": 0
+            },
+            {
+              "type": "null"
+            }
+          ]
+        },
+        "snapshotUri": {
+          "anyOf": [
+            {
+              "type": "string",
+              "format": "uri-reference"
+            },
+            {
+              "type": "null"
+            }
+          ]
+        }
+      },
+      "required": [
+        "type",
+        "title",
+        "status",
+        "detail",
+        "instance",
+        "code",
+        "correlationId",
+        "retryAfterSeconds",
+        "snapshotUri"
+      ],
+      "additionalProperties": false
+    },
+    "PageToken": {
