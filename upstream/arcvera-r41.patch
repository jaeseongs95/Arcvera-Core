diff --git a/codex-rs/core/src/session/context_cache.rs b/codex-rs/core/src/session/context_cache.rs
new file mode 100644
index 0000000000000000000000000000000000000000..959d91dfb4752ca0ca9a4ec8fe4fa3652c989ab3
