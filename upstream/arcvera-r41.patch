index 0000000000000000000000000000000000000000..249efbb032ce46a80c687c0723eb172e85f6a136
--- /dev/null
+++ b/java/gradlew
@@ -0,0 +1,248 @@
+#!/bin/sh
+
+#
+# Copyright © 2015 the original authors.
