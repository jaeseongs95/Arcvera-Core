+            )
+            .await
+            .expect("real index fixture setup");
+        let mut revision = created["revision"].as_u64().expect("created revision");
+        for batch in source_ids.chunks(256) {
+            let arguments = json!({
+                "action":"apply", "expected_revision":revision,
