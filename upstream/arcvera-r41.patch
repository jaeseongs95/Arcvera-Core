+    let (session, _) = make_session_and_context().await;
+    let old = CancellationToken::new();
+    let make = |port: u16, secret: &str| {
+        HashMap::from([(
+            "codex_tui".to_owned(),
+            serde_json::from_value::<McpServerConfig>(serde_json::json!({
