+pub(crate) struct CompositionCache {
+    runtime_id: uuid::Uuid,
+    identity: CompositionIdentity,
+    observation: ContextCacheView,
+    limits: ContextLimits,
+    request_sizes: Option<ContextRequestSizes>,
+    snapshot_id: String,
+    composition: HistoryComposition,
