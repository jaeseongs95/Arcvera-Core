-        let queue = v8::MicrotaskQueue::new(isolate, v8::MicrotasksPolicy::Explicit);
-        {
-            v8::scope!(let scope, isolate);
-            let context = v8::Context::new(scope, Default::default());
-            let default_queue = context.get_microtask_queue().unwrap();
