+        "kind = 'legacy'\nretention = '30m'",
+        "kind = 'implicit'\nttl = '30m'\nretention = '24h'",
+        "kind = 'explicit'\nttl = '30m'",
+    ] {
+        assert!(
+            toml::from_str::<ModelProviderInfo>(&format!(
+                "[capabilities.prompt_cache]\n{policy}\n"
