+pub(crate) fn retain_unique_original(
+    original: &mut Option<ResponseItem>,
+    candidate: &ResponseItem,
+    source_id: &str,
+) -> ThreadStoreResult<()> {
+    if codex_history::context_index::ContextIndex::source_id(candidate).as_deref()
+        != Some(source_id)
