+        .expect("valid policy after rollback");
+    let records = vec![
+        RolloutItem::SessionMeta(Box::new(SessionMetaLine {
+            meta: SessionMeta {
+                session_id: thread_id.into(),
+                id: thread_id,
+                timestamp: timestamp.to_owned(),
