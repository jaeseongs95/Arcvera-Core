--- /dev/null
+++ b/java/src/main/java/io/arcvera/core/bootstrap/LocalCredentialIntrospector.java
@@ -0,0 +1,28 @@
+package io.arcvera.core.bootstrap;
+
+import java.util.Map;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.oauth2.core.DefaultOAuth2AuthenticatedPrincipal;
+import org.springframework.security.oauth2.core.OAuth2AuthenticatedPrincipal;
+import org.springframework.security.oauth2.server.resource.introspection.BadOpaqueTokenException;
+import org.springframework.security.oauth2.server.resource.introspection.OpaqueTokenIntrospector;
+import org.springframework.stereotype.Component;
+
+@Component
+public final class LocalCredentialIntrospector implements OpaqueTokenIntrospector {
+    private final CredentialRegistry registry;
+
+    public LocalCredentialIntrospector(CredentialRegistry registry) { this.registry = registry; }
+
+    @Override
+    public OAuth2AuthenticatedPrincipal introspect(String token) {
+        var claims = registry.authenticate(token).orElseThrow(() -> new BadOpaqueTokenException("Invalid local credential"));
+        var authorities = claims.scopes().stream().<GrantedAuthority>map(scope -> new SimpleGrantedAuthority("SCOPE_" + scope)).toList();
+        return new DefaultOAuth2AuthenticatedPrincipal(claims.osPrincipal(), Map.of(
+                "instanceId", claims.instanceId().toString(),
+                "credentialId", claims.credentialId().toString(),
+                "generation", claims.generation(),
+                "scope", claims.scopes()), authorities);
+    }
+}
diff --git a/java/src/main/java/io/arcvera/core/bootstrap/LocalHttpsConfiguration.java b/java/src/main/java/io/arcvera/core/bootstrap/LocalHttpsConfiguration.java
new file mode 100644
index 0000000000000000000000000000000000000000..03963cee4599538c54d21f8536450bac3b766297
--- /dev/null
+++ b/java/src/main/java/io/arcvera/core/bootstrap/LocalHttpsConfiguration.java
@@ -0,0 +1,60 @@
+package io.arcvera.core.bootstrap;
+
+import java.net.InetAddress;
+import java.util.Collections;
+import jakarta.servlet.http.HttpServletRequest;
+import org.springframework.boot.ssl.DefaultSslBundleRegistry;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.boot.web.server.ConfigurableWebServerFactory;
+import org.springframework.boot.web.server.Ssl;
+import org.springframework.boot.web.server.WebServerFactoryCustomizer;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;
+import org.springframework.security.config.http.SessionCreationPolicy;
+import org.springframework.security.oauth2.server.resource.introspection.OpaqueTokenIntrospector;
+import org.springframework.security.web.SecurityFilterChain;
+
+/** Imported explicitly by the local server assembly, after its protection prerequisites are established. */
+@Configuration(proxyBeanMethods = false)
+@EnableWebSecurity
+@ConditionalOnProperty(name = "arcvera.bootstrap.explicit-https", havingValue = "true")
+public class LocalHttpsConfiguration {
+    @Bean
+    WebServerFactoryCustomizer<ConfigurableWebServerFactory> localHttpsServer(LocalTlsMaterial material) {
+        return factory -> {
+            try {
+                factory.setAddress(InetAddress.getByAddress(new byte[]{127, 0, 0, 1}));
+            } catch (java.net.UnknownHostException impossible) {
+                throw new IllegalStateException("Invalid loopback bytes", impossible);
+            }
+            factory.setPort(0);
+            var bundles = new DefaultSslBundleRegistry("arcvera-local", material.serverBundle());
+            factory.setSslBundles(bundles);
+            var ssl = Ssl.forBundle("arcvera-local");
+            ssl.setEnabledProtocols(new String[]{"TLSv1.3", "TLSv1.2"});
+            factory.setSsl(ssl);
+        };
+    }
+
+    @Bean
+    SecurityFilterChain localSecurity(HttpSecurity http, OpaqueTokenIntrospector introspector) throws Exception {
+        http.authorizeHttpRequests(authorize -> authorize
+                        .requestMatchers(LocalHttpsConfiguration::invalidAuthority).denyAll()
+                        .anyRequest().authenticated())
+                .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
+                .requestCache(cache -> cache.disable())
+                .httpBasic(basic -> basic.disable())
+                .formLogin(form -> form.disable())
+                .oauth2ResourceServer(oauth -> oauth.opaqueToken(opaque -> opaque.introspector(introspector)));
+        return http.build();
+    }
+
+    private static boolean invalidAuthority(HttpServletRequest request) {
+        var hosts = Collections.list(request.getHeaders("Host"));
+        return hosts.size() != 1 || !("127.0.0.1:" + request.getLocalPort()).equals(hosts.getFirst())
+                || !"127.0.0.1".equals(request.getServerName())
+                || request.getServerPort() != request.getLocalPort() || request.getHeader("Origin") != null;
+    }
+}
diff --git a/java/src/main/java/io/arcvera/core/bootstrap/LocalTlsMaterial.java b/java/src/main/java/io/arcvera/core/bootstrap/LocalTlsMaterial.java
new file mode 100644
index 0000000000000000000000000000000000000000..e98f1a3cf6a52dd1c9d546a30529a0052f6c4bfc
--- /dev/null
+++ b/java/src/main/java/io/arcvera/core/bootstrap/LocalTlsMaterial.java
@@ -0,0 +1,80 @@
+package io.arcvera.core.bootstrap;
+
+import java.math.BigInteger;
+import java.security.GeneralSecurityException;
+import java.security.KeyPairGenerator;
+import java.security.KeyStore;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.security.cert.X509Certificate;
+import java.security.spec.ECGenParameterSpec;
+import java.time.Clock;
+import java.time.Duration;
+import java.util.Base64;
+import java.util.Date;
+import java.util.HexFormat;
+import java.util.Objects;
+import org.bouncycastle.asn1.x500.X500Name;
+import org.bouncycastle.asn1.x509.BasicConstraints;
+import org.bouncycastle.asn1.x509.ExtendedKeyUsage;
+import org.bouncycastle.asn1.x509.Extension;
+import org.bouncycastle.asn1.x509.GeneralName;
+import org.bouncycastle.asn1.x509.GeneralNames;
+import org.bouncycastle.asn1.x509.KeyPurposeId;
+import org.bouncycastle.asn1.x509.KeyUsage;
+import org.bouncycastle.cert.jcajce.JcaX509CertificateConverter;
+import org.bouncycastle.cert.jcajce.JcaX509v3CertificateBuilder;
+import org.bouncycastle.operator.OperatorCreationException;
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+import org.springframework.boot.ssl.SslBundle;
+import org.springframework.boot.ssl.SslBundleKey;
+import org.springframework.boot.ssl.SslStoreBundle;
+
+/** A process-local TLS identity. Its private key is never exported into the descriptor. */
+public final class LocalTlsMaterial {
+    private final X509Certificate certificate;
+    private final SslBundle serverBundle;
+    private final String numericLoopback;
+
+    public LocalTlsMaterial(Clock clock, SecureRandom random, String numericLoopback)
+            throws GeneralSecurityException, java.io.IOException, OperatorCreationException {
+        Objects.requireNonNull(clock);
+        Objects.requireNonNull(random);
+        if (!"127.0.0.1".equals(numericLoopback) && !"::1".equals(numericLoopback)) {
+            throw new IllegalArgumentException("Numeric loopback address required");
+        }
+        this.numericLoopback = numericLoopback;
+        var generator = KeyPairGenerator.getInstance("EC");
+        generator.initialize(new ECGenParameterSpec("secp256r1"), random);
+        var keyPair = generator.generateKeyPair();
+        var subject = new X500Name("CN=Arcvera local instance");
+        var now = clock.instant();
+        var builder = new JcaX509v3CertificateBuilder(subject, new BigInteger(128, random).setBit(127),
+                Date.from(now.minusSeconds(30)), Date.from(now.plus(Duration.ofDays(1))), subject, keyPair.getPublic());
+        builder.addExtension(Extension.basicConstraints, true, new BasicConstraints(false));
+        builder.addExtension(Extension.keyUsage, true, new KeyUsage(KeyUsage.digitalSignature));
+        builder.addExtension(Extension.extendedKeyUsage, false, new ExtendedKeyUsage(KeyPurposeId.id_kp_serverAuth));
+        builder.addExtension(Extension.subjectAlternativeName, false,
+                new GeneralNames(new GeneralName(GeneralName.iPAddress, numericLoopback)));
+        var signer = new JcaContentSignerBuilder("SHA256withECDSA").setSecureRandom(random).build(keyPair.getPrivate());
+        certificate = new JcaX509CertificateConverter().getCertificate(builder.build(signer));
+        byte[] passwordBytes = new byte[32];
+        random.nextBytes(passwordBytes);
+        String password = Base64.getUrlEncoder().withoutPadding().encodeToString(passwordBytes);
+        var store = KeyStore.getInstance("PKCS12");
+        store.load(null, null);
+        store.setKeyEntry("arcvera", keyPair.getPrivate(), password.toCharArray(), new java.security.cert.Certificate[]{certificate});
+        serverBundle = SslBundle.of(SslStoreBundle.of(store, password, null), SslBundleKey.of(password, "arcvera"));
+    }
+
+    public X509Certificate certificate() { return certificate; }
+    public String numericLoopback() { return numericLoopback; }
+    public SslBundle serverBundle() { return serverBundle; }
+    public String trustAnchorDer() throws GeneralSecurityException {
+        return Base64.getEncoder().encodeToString(certificate.getEncoded());
+    }
+    public String spkiSha256() throws GeneralSecurityException {
+        return "sha256:" + HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(certificate.getPublicKey().getEncoded()));
+    }
+    @Override public String toString() { return "LocalTlsMaterial[redacted]"; }
+}
