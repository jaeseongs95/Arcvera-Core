+        let fields = events.lock().unwrap();
+        assert!(fields.iter().any(|fields| {
+            fields
+                .get("stage")
+                .is_some_and(|stage| stage == "completed")
+                && fields.get("wire_ordinal") == Some(&ordinal)
+                && fields
+                    .get("response_id")
+                    .is_some_and(|id| id == "resp_task")
+        }));
