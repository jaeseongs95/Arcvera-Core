+                    responses::ev_output_text_delta("resumed owner fence armed"),
+                ]),
+            },
+            StreamingSseChunk {
+                gate: Some(gate),
+                body: responses::sse(vec![
+                    responses::ev_function_call("stale-tool", "capacity_effect", "{}"),
+                    responses::ev_completed("resumed"),
+                ]),
+            },
+        ],
+    ])
