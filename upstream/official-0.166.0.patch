+        );
+        assert_eq!(app.cron.scheduler.jobs.len(), 1);
+        assert_eq!(app.cron.scheduler.jobs[0].prompt, "원문  프롬프트\n보존");
+        let mut changed = body.clone();
+        changed["prompt"] = json!("다른 본문");
+        let conflict = request(&app, &session, thread, changed);
+        assert_eq!(
+            apply(&mut app, &session, conflict).await["result"]["reason"],
+            "requestIdConflict"
+        );
+        let new_id = uuid::Uuid::new_v4().to_string();
+        let mut expired_body = body.clone();
+        expired_body["requestId"] = json!(new_id);
+        let expired = request(&app, &session, thread, expired_body);
+        let (pending, reply) = PendingRequest::for_test(expired, Duration::ZERO);
+        app.handle_desktop_cron_request(&session, pending).await;
+        assert_eq!(
+            serde_json::to_value(reply.await?)?["error"]["code"],
+            "requestTimeout"
+        );
+        let mut stale = request(&app, &session, thread, json!({"type":"list"}));
+        stale.scope.as_mut().unwrap().backend_epoch = DecimalU64::new(1);
+        assert_eq!(
+            apply(&mut app, &session, stale).await["error"]["code"],
+            "staleTarget"
+        );
+        assert_eq!(app.cron.scheduler.jobs.len(), 1);
+        assert_eq!(app.cron.desktop.receipts.len(), 1);
+        app.cron
+            .invalidate_backend(session.backend_id(), "연결 교체");
+        assert_eq!(app.cron.desktop.receipts.len(), 1);
+        session.shutdown().await?;
+        worker.await??;
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn desktop_actor_cancel_uses_own_connection_cap_and_authoritative_receipt()
+    -> color_eyre::Result<()> {
+        use codex_app_server_protocol::JSONRPCMessage;
+        for capability in [None, Some(false), Some(true)] {
+            let (mut app, mut events, _ops) =
+                crate::app::tests::make_test_app_with_channels().await;
+            let (session, mut observed, worker) = super::super::app_server_requests::retained_reply_tests::connection_with_expected_turn_interrupt(capability).await?;
+            let thread = ThreadId::new();
+            app.active_thread_id = Some(thread);
+            app.primary_thread_id = Some(thread);
+            app.ensure_thread_channel(thread);
+            let now = MonotonicInstant::now();
+            let target = CronTarget {
+                backend: session.backend_id(),
+                epoch: 0,
+                thread,
+            };
+            let id = app
+                .cron
+                .scheduler
+                .add(
+                    target.clone(),
+                    "saved".into(),
+                    Schedule::Every(Duration::from_secs(1)),
+                    now,
+                )
+                .unwrap();
+            let attempt = app
+                .cron
+                .scheduler
+                .due(now + Duration::from_secs(1))
+                .pop()
+                .unwrap()
+                .attempt;
+            app.cron.scheduler.submitted(
+                id,
+                attempt,
+                crate::cron::Submission::Started("owned-cron".into()),
+            );
+            let request_id = uuid::Uuid::new_v4().to_string();
+            let body = json!({"type":"cancel", "requestId":request_id, "jobId":id.to_string()});
+            let cancel = request(&app, &session, thread, body.clone());
+            let (pending, reply) = PendingRequest::for_test(cancel, Duration::from_secs(5));
+            app.handle_desktop_cron_request(&session, pending).await;
+            if capability == Some(true) {
+                let message = tokio::time::timeout(Duration::from_secs(5), observed.recv())
+                    .await?
+                    .unwrap();
+                let JSONRPCMessage::Request(message) = message else {
+                    panic!("정확 취소 요청");
+                };
+                assert_eq!(message.method, "turn/interrupt");
+                assert_eq!(message.params.unwrap()["turnId"], "owned-cron");
+                let event = tokio::time::timeout(Duration::from_secs(5), async {
+                    loop {
+                        if let Some(AppEvent::DesktopCronCancelReply(reply)) = events.recv().await {
+                            break *reply;
+                        }
+                    }
+                })
+                .await?;
+                app.handle_desktop_cron_cancel_reply(event);
+                assert_eq!(
+                    serde_json::to_value(reply.await?)?["result"]["status"],
+                    "applied"
+                );
+                assert!(matches!(
+                    app.cron.scheduler.jobs[0].phase,
+                    Phase::Running { .. }
+                ));
+            } else {
+                assert_eq!(
+                    serde_json::to_value(reply.await?)?["result"]["status"],
+                    "unsupported"
+                );
+                assert!(observed.try_recv().is_err());
+                assert!(matches!(
+                    app.cron.scheduler.jobs[0].phase,
+                    Phase::Running {
+                        cancelling: false,
+                        ..
+                    }
+                ));
+            }
+            let mut list = request(&app, &session, thread, json!({"type":"list"}));
+            list.reconcile = Some(Reconcile {
+                request: from_json(&serde_json::to_vec(&body)?).unwrap(),
+            });
+            let result = apply(&mut app, &session, list).await;
+            assert_eq!(result["result"]["mutationState"], "clear");
+            assert_eq!(result["result"]["reconciledRequestId"], request_id);
+            assert_eq!(
+                result["result"]["supportsExpectedTurnInterrupt"],
+                capability.map_or(serde_json::Value::Null, serde_json::Value::Bool)
+            );
+            assert_eq!(app.cron.desktop.receipts.len(), 1);
+            session.shutdown().await?;
+            worker.await??;
+        }
+        Ok(())
+    }
+}
diff --git a/codex-rs/tui/src/app/diagnostics_control.rs b/codex-rs/tui/src/app/diagnostics_control.rs
new file mode 100644
index 000000000..dabfdb596
--- /dev/null
+++ b/codex-rs/tui/src/app/diagnostics_control.rs
@@ -0,0 +1,89 @@
+//! Explicit local diagnostic controls; filesystem work never runs on the UI task.
+
+use crate::i18n::Locale;
+use codex_diagnostics::settings_control;
+use serde_json::Value;
+use serde_json::json;
+use std::path::PathBuf;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) enum Action {
+    LoggingStatus,
+    LoggingSet { enabled: bool },
+    CacheDiagnosticsStatus,
+    CacheDiagnosticsSet { response: bool, wire: bool },
+}
+
+pub(super) async fn handle(action: Action) -> Result<Value, String> {
+    let locale = crate::i18n::locale();
+    // The local client owns these diagnostics, including when its backend is remote.
+    let home = codex_utils_home_dir::find_codex_home().map_err(|error| {
+        crate::i18n::message_for(
+            locale,
+            "diagnostics-home-failed",
+            &[("error", &error.to_string())],
+        )
+    })?;
+    control_at_home(action, home.to_path_buf(), locale).await
+}
+
+async fn control_at_home(action: Action, home: PathBuf, locale: Locale) -> Result<Value, String> {
+    if matches!(
+        action,
+        Action::CacheDiagnosticsSet {
+            response: false,
+            wire: true
+        }
+    ) {
+        return Err(crate::i18n::message_for(
+            locale,
+            "diagnostics-cache-wire-requires-response",
+            &[],
+        ));
+    }
+    let mutation = matches!(
+        action,
+        Action::LoggingSet { .. } | Action::CacheDiagnosticsSet { .. }
+    );
+    let status = tokio::task::spawn_blocking(move || match action {
+        Action::LoggingStatus | Action::CacheDiagnosticsStatus => settings_control::status(&home),
+        Action::LoggingSet { enabled } => {
+            settings_control::update(&home, settings_control::Update::Logging { enabled })
+        }
+        Action::CacheDiagnosticsSet { response, wire } => {
+            settings_control::update(&home, settings_control::Update::Cache { response, wire })
+        }
+    })
+    .await
+    .map_err(|error| {
+        crate::i18n::message_for(
+            locale,
+            "diagnostics-operation-unconfirmed",
+            &[("error", &error.to_string())],
+        )
+    })?
+    .map_err(|error| {
+        if error.kind() == std::io::ErrorKind::WouldBlock {
+            crate::i18n::message_for(locale, "diagnostics-settings-busy", &[])
+        } else {
+            crate::i18n::message_for(
+                locale,
+                "diagnostics-operation-failed",
+                &[("error", &error.to_string())],
+            )
+        }
+    })?;
+    Ok(json!({
+        "scope": "local_client",
+        "settings": status,
+        "message": crate::i18n::message_for(
+            locale,
+            if mutation { "diagnostics-saved-next-launch" } else { "diagnostics-status" },
+            &[],
+        ),
+    }))
+}
+
+#[cfg(test)]
+#[path = "diagnostics_control_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/app/diagnostics_control_tests.rs b/codex-rs/tui/src/app/diagnostics_control_tests.rs
new file mode 100644
index 000000000..6a90dc8c3
--- /dev/null
+++ b/codex-rs/tui/src/app/diagnostics_control_tests.rs
@@ -0,0 +1,77 @@
+use super::*;
+
+#[tokio::test]
+async fn diagnostic_actions_report_saved_settings_without_changing_runtime_or_other_settings() {
+    for locale in [Locale::English, Locale::Korean] {
+        let home = tempfile::tempdir().unwrap();
+        let current = codex_diagnostics::cache_diagnostics::initialized_process_mode();
+        let initial = control_at_home(Action::LoggingStatus, home.path().to_path_buf(), locale)
+            .await
+            .unwrap();
+        assert_eq!(initial["settings"]["saved_logging"]["enabled"], false);
+        assert_eq!(std::fs::read_dir(home.path()).unwrap().count(), 0);
+        let enabled = control_at_home(
+            Action::LoggingSet { enabled: true },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(enabled["settings"]["saved_logging"]["enabled"], true);
+        assert_eq!(enabled["settings"]["saved_cache"]["response"], false);
+        assert_eq!(
+            enabled["settings"]["next_process_mode_if_environment_unchanged"]["response_enabled"],
+            false
+        );
+        let cache = control_at_home(
+            Action::CacheDiagnosticsSet {
+                response: true,
+                wire: true,
+            },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(cache["settings"]["saved_cache"]["wire"], true);
+        assert_eq!(
+            cache["settings"]["next_process_mode_if_environment_unchanged"]["wire_enabled"],
+            true
+        );
+        assert_eq!(
+            codex_diagnostics::cache_diagnostics::initialized_process_mode(),
+            current
+        );
+        assert!(cache["message"].as_str().unwrap().contains(match locale {
+            Locale::English => "next launch",
+            Locale::Korean => "다음 실행",
+        }));
+        let before = std::fs::read(home.path().join("cli-cache-diagnostics.toml")).unwrap();
+        let error = control_at_home(
+            Action::CacheDiagnosticsSet {
+                response: false,
+                wire: true,
+            },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap_err();
+        assert!(error.contains(match locale {
+            Locale::English => "requires response",
+            Locale::Korean => "응답 관측",
+        }));
+        assert_eq!(
+            std::fs::read(home.path().join("cli-cache-diagnostics.toml")).unwrap(),
+            before
+        );
+        let readback = control_at_home(
+            Action::CacheDiagnosticsStatus,
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(readback["settings"]["saved_cache"]["wire"], true);
+    }
+}
