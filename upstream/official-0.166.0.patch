+    tokio::time::timeout(timeout, barrier.wait()).await?;
+    assert!(tokio::time::timeout(timeout, reload).await??.is_err());
+    assert!(Arc::ptr_eq(&before, &replacement.thread.config().await));
+    Ok(())
+}
