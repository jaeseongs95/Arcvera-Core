+        }
+        let mut token = Self([0; 32]);
+        for (byte, pair) in token.0.iter_mut().zip(value.as_bytes().chunks_exact(2)) {
+            let digit = |value: u8| {
+                if value <= b'9' {
+                    value - b'0'
+                } else {
+                    value - b'a' + 10
+                }
+            };
+            *byte = digit(pair[0]) * 16 + digit(pair[1]);
+        }
