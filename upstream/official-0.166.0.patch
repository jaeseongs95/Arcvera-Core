+            "삭제한 예약을 같은 호출 재전송으로 되살리지 않음"
+        );
+        let other_caller = ThreadId::new();
+        while app.cron.model_calls.len() < MAX_MODEL_CALLS {
+            app.cron.model_calls.insert(
+                (
+                    connection.backend,
+                    connection.id,
+                    other_caller,
+                    "other-turn".into(),
+                    uuid::Uuid::new_v4().to_string(),
