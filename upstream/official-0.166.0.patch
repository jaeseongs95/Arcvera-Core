+        for _ in 0..2 {
+            command(home.path(), project.path())?
+                .assert()
+                .success()
+                .stdout(contains(heading));
+        }
+        // A CLI/session override must not become a display preference either.
+        command(home.path(), project.path())?
+            .args(["-c", "ui_language='ko'"])
+            .assert()
+            .success()
+            .stdout(contains(heading));
