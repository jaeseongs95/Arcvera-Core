+        app.handle_cron_tool_call(&session, request).await;
+        assert!(response.await?.success);
+        assert!(app.cron.scheduler.jobs.is_empty());
+        let (request, response) = model_request(
+            connection.clone(),
+            caller,
+            "same-add",
+            "add --every 10m -- 원래 대화 확인",
+        );
+        app.handle_cron_tool_call(&session, request).await;
+        assert!(response.await?.success);
