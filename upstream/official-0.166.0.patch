+                                "modelProvider":"test-provider", "createdAt":1, "updatedAt":2,
+                                "status":{"type":"idle"}, "cwd":std::env::temp_dir(), "cliVersion":"0.0.0",
+                                "source":source, "canAcceptDirectInput":case != "direct-input-denied", "turns":[]
+                            }})
