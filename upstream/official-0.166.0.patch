+                ShutdownAction::Noop
+            ));
+        }
+        drop(in_flight);
+        assert!(matches!(
+            shutdown.update(0, *active.borrow(), 1),
+            ShutdownAction::Finish
+        ));
+        assert!(!shutdown.forced());
