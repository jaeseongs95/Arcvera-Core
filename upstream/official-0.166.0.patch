+                let prefix = if locale == Locale::English {
+                    "Failed to set trust for "
+                } else {
+                    "다음 경로의 신뢰를 설정하지 못했습니다: "
+                };
+                assert_eq!(
+                    crate::i18n::message(
+                        "dialogs-onboarding-trust-error",
+                        &[("path", path), ("error", error)]
+                    ),
+                    format!("{prefix}{path}: {error}")
+                );
+            });
+        }
+    }
