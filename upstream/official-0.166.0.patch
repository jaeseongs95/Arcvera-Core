+            history_mode: codex_protocol::protocol::ThreadHistoryMode::Paginated,
+            history_base: None,
+            subagent_history_start_ordinal: None,
+            initial_window_id: Uuid::now_v7().to_string(),
+            runtime_workspace_roots: None,
+            metadata: ThreadPersistenceMetadata {
+                cwd: Some(codex_home.path().to_path_buf()),
+                model_provider: "mock_provider".to_string(),
+                memory_mode: ThreadMemoryMode::Enabled,
+            },
+        })
+        .await?;
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await?;
+    let mut items = Vec::new();
+    for (turn_id, item_ids, size) in [
+        (
+            "large-turn",
+            vec!["large-agent"],
+            codex_thread_store::HISTORY_PAGE_TARGET_BYTES + 1,
+        ),
+        (
+            "normal-turn",
+            vec!["agent-1", "agent-2", "agent-3"],
+            3 * 1024 * 1024,
+        ),
+    ] {
+        items.push(paginated_turn_started(turn_id));
+        for item_id in item_ids {
+            items.push(paginated_completed_item(
+                thread_id,
+                turn_id,
+                CoreTurnItem::AgentMessage(AgentMessageItem {
+                    id: item_id.to_string(),
+                    content: vec![AgentMessageContent::Text {
+                        text: "x".repeat(size),
+                    }],
+                    phase: None,
+                    memory_citation: None,
+                    delivery: None,
+                    questions: None,
+                }),
+            ));
+        }
+        items.push(paginated_turn_completed(turn_id));
+    }
+    store
+        .append_items(AppendThreadItemsParams { thread_id, items })
+        .await?;
+    store.shutdown_thread(thread_id).await?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let shells = read_turns_page(
+        &mut mcp,
+        thread_id,
+        None,
+        Some(10),
+        SortDirection::Desc,
+        Some(TurnItemsView::NotLoaded),
+    )
+    .await?;
+    assert_eq!(shells.data.len(), 2);
+    assert!(shells.data.iter().all(|turn| turn.items.is_empty()));
+    let first = read_items_page(
+        &mut mcp,
+        thread_id,
+        Some("normal-turn"),
+        None,
+        Some(100),
+        SortDirection::Asc,
+    )
+    .await?;
+    assert_eq!(first.data.len(), 2);
+    assert!(serde_json::to_vec(&first)?.len() <= codex_thread_store::HISTORY_PAGE_TARGET_BYTES);
+    let second = read_items_page(
+        &mut mcp,
+        thread_id,
+        Some("normal-turn"),
+        first.next_cursor,
+        Some(100),
+        SortDirection::Asc,
+    )
+    .await?;
+    assert_eq!(second.data.len(), 1);
+    assert!(second.next_cursor.is_none());
+    let large = read_items_page(
+        &mut mcp,
+        thread_id,
+        Some("large-turn"),
+        None,
+        Some(100),
+        SortDirection::Asc,
+    )
+    .await?;
+    assert_eq!(large.data.len(), 1);
+    assert!(large.next_cursor.is_none());
+    let ThreadItemPayload::AgentMessage { text, .. } = &large.data[0].item.payload else {
+        panic!("expected intact large agent message");
+    };
+    assert_eq!(
+        text.len(),
+        codex_thread_store::HISTORY_PAGE_TARGET_BYTES + 1
+    );
+    assert!(text.bytes().all(|byte| byte == b'x'));
+    // Full is an explicit complete-turn request: retain the requested count and
+    // accept the combined response even when it exceeds the soft page target.
+    let full = read_turns_page(
+        &mut mcp,
+        thread_id,
+        None,
+        Some(10),
+        SortDirection::Desc,
+        Some(TurnItemsView::Full),
+    )
+    .await?;
+    assert_eq!(full.data.len(), 2);
+    assert!(full.next_cursor.is_none());
+    assert_eq!(
+        full.data.iter().map(|turn| turn.items.len()).sum::<usize>(),
+        4
+    );
+    // Complete/ThroughTurn clients repeatedly use this same existing paging API.
+    let mut cursor = None;
+    let mut ids = Vec::new();
+    loop {
+        let page = read_items_page(
+            &mut mcp,
+            thread_id,
+            None,
+            cursor,
+            Some(100),
+            SortDirection::Desc,
+        )
+        .await?;
+        ids.extend(page.data.iter().map(|entry| entry.item.id().to_string()));
+        cursor = page.next_cursor;
+        if cursor.is_none() {
+            break;
+        }
+    }
+    assert_eq!(ids, vec!["agent-3", "agent-2", "agent-1", "large-agent"]);
+    // Payload reads do not change the metadata-only shell contract.
+    let shells_after = read_turns_page(
+        &mut mcp,
+        thread_id,
+        None,
+        Some(10),
+        SortDirection::Desc,
+        Some(TurnItemsView::NotLoaded),
+    )
+    .await?;
+    assert_eq!(shells_after.data, shells.data);
+    let sqlite = codex_state::SqliteConfig::new_for_testing(codex_home.path().abs());
+    let pool = codex_state::open_thread_history_db(&sqlite).await?;
+    sqlx::query("DELETE FROM thread_history_projection_state WHERE thread_id = ?")
+        .bind(thread_id.to_string())
+        .execute(&pool)
+        .await?;
+    let id = mcp
+        .send_thread_turns_list_request(ThreadTurnsListParams {
+            thread_id: thread_id.to_string(),
+            cursor: None,
+            limit: Some(10),
+            sort_direction: Some(SortDirection::Desc),
+            items_view: Some(TurnItemsView::NotLoaded),
+        })
+        .await?;
+    let error: JSONRPCError = timeout(
+        DEFAULT_READ_TIMEOUT,
+        mcp.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    assert_eq!(
+        error.error.data,
+        Some(json!({ "kind": "historyProjectionUnavailable" }))
+    );
+    Ok(())
+}
