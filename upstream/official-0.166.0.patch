+fn decode_mac(mac: &MacHex) -> [u8; 32] {
+    fn digit(byte: u8) -> u8 {
+        if byte <= b'9' {
+            byte - b'0'
+        } else {
+            byte - b'a' + 10
+        }
+    }
+    let mut result = [0; 32];
+    for (byte, pair) in result.iter_mut().zip(mac.0.as_bytes().chunks_exact(2)) {
+        *byte = digit(pair[0]) * 16 + digit(pair[1]);
+    }
