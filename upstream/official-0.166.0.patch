+            ("\\\"quoted", "\"\\\\\\\"quoted\""),
+        ] {
+            let mut actual = Vec::new();
+            append_argument(OsStr::new(input), &mut actual).unwrap();
+            assert_eq!(String::from_utf16(&actual).unwrap(), expected);
+        }
