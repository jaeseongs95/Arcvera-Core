+impl CodeModeSession for RecordingSession {
+    fn execute<'a>(
+        &'a self,
+        _request: codex_code_mode::ExecuteRequest,
+        _delegate: Arc<dyn codex_code_mode::CodeModeSessionDelegate>,
+        _preempt: Option<CancellationToken>,
