+        if let Some(state_db) = state_db {
+            let goal = self.get_thread_goal(state_db, thread_id).await?;
+            if goal.is_some_and(|goal| goal.status != ThreadGoalStatus::Complete) {
+                return Ok(None);
+            }
+        }
+        Ok(Some(GoalCleanupGuard { _permit: None }))
+    }
