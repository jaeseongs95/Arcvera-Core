+            let started = Arc::new(Notify::new());
+            let cleanups = Arc::new(AtomicUsize::new(0));
+            let cleanup = {
+                let release = Arc::clone(&release);
+                let started = Arc::clone(&started);
+                let cleanups = Arc::clone(&cleanups);
