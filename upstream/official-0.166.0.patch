+            )
+            .await
+            .unwrap(),
+        Outcome::NotApplied
+    );
+    assert_eq!(
+        harness
+            .manager
+            .control_managed_subagent(
+                parent_id,
+                parent_runtime,
+                child.thread_id,
+                None,
+                Action::Resume
+            )
+            .await
+            .unwrap(),
+        Outcome::Applied
+    );
+    let resumed = harness.manager.get_thread(child.thread_id).await.unwrap();
+    assert_ne!(old_runtime, resumed.runtime_id());
+    assert_eq!(
+        harness
+            .manager
+            .control_managed_subagent(
+                parent_id,
+                parent_runtime,
+                child.thread_id,
+                Some(old_runtime),
+                Action::Close
+            )
+            .await
+            .unwrap(),
+        Outcome::NotApplied
+    );
+    assert!(resumed.is_running());
+    let _ = harness
+        .manager
+        .shutdown_all_threads_bounded(Duration::from_secs(5))
