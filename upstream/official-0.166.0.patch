+async fn release_confirmed_owner(inner: &Arc<StdioServerProcessHandleInner>) -> bool {
+    if inner.local_discovery_root.is_some()
+        && !inner.local_discovery_confirmed.load(Ordering::Acquire)
+    {
+        return false;
+    }
+    let confirmed = match &inner.kind {
