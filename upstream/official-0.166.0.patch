+                &telemetry,
+                None,
+                codex_protocol::config_types::ReasoningSummary::None,
+                None,
+                &metadata,
+                &trace,
+            )
+            .await
+        {
+            Err(error) => error,
+            Ok(_) => panic!("changed owner must abort before generation dispatch"),
+        };
+        assert!(matches!(error.details(), CodexErrorDetails::TurnAborted));
+        assert_ne!(
+            session.capacity_retry_owner(),
