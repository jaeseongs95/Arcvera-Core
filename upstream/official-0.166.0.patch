+//! Display-only retention budgets. These do not constrain model context or durable rollout.
+//!
+//! The byte budget counts serialized protocol payload or the retained logical source of cells;
+//! allocator overhead and renderer caches have separate lifetimes and are not included. Measure
+//! process peak memory separately. Canonical item payload and committed cell source each have
+//! this admission ceiling. Explicit export/copy-range/search/selection operations retain their
+//! own temporary sources until they end. The latest response/plan copy source, input,
+//! approval/lifecycle state, and still-unprinted
+//! native FIFO output have separate operational lifetimes. A single oversized payload fails explicitly rather than
+//! silently dropping a prefix and presenting the suffix as the original item.
+
+use codex_app_server_protocol::{Turn, TurnItemsView};
+use serde::Serialize;
+use std::io::Write;
+
+pub(crate) const MAX_HISTORY_TURNS: usize = 30;
+pub(crate) const MAX_HISTORY_ITEMS: usize = 400;
+pub(crate) const MAX_HISTORY_BYTES: usize = 8 * 1024 * 1024;
+pub(crate) const OVERSIZED_HISTORY: &str = "표시 이력 항목이 메모리 제한을 초과했습니다. 원본은 보존되며 다른 대화 구간을 계속 탐색할 수 있습니다.";
+
+/// Count once at admission, without allocating a second serialized copy. This intentionally
+/// stops scanning a giant string when serde writes the chunk that exceeds the display budget.
+pub(crate) fn payload_bytes(value: &impl Serialize) -> Result<usize, serde_json::Error> {
+    struct Counter(usize);
+    impl Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if bytes.len() > MAX_HISTORY_BYTES.saturating_sub(self.0) {
+                return Err(std::io::Error::other(OVERSIZED_HISTORY));
+            }
+            self.0 += bytes.len();
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut counter = Counter(0);
+    serde_json::to_writer(&mut counter, value)?;
+    Ok(counter.0)
+}
+
+pub(crate) fn turn_shell(turn: &Turn) -> Turn {
+    Turn {
+        id: turn.id.clone(),
+        root_turn_id: turn.root_turn_id.clone(),
+        items: Vec::new(),
+        items_view: TurnItemsView::NotLoaded,
+        status: turn.status.clone(),
+        error: turn.error.clone(),
+        started_at: turn.started_at,
+        completed_at: turn.completed_at,
+        duration_ms: turn.duration_ms,
+    }
+}
diff --git a/codex-rs/tui/src/i18n.rs b/codex-rs/tui/src/i18n.rs
new file mode 100644
index 000000000..61c1943e4
--- /dev/null
+++ b/codex-rs/tui/src/i18n.rs
@@ -0,0 +1,289 @@
+//! UI-only language selection. Never apply this dictionary to prompts, tool arguments,
+//! slash command tokens, paths, or text supplied by the user or a server.
+//!
+//! `CODEX_UI_LANGUAGE=ko|en` overrides the client preference (with legacy base fallback).
+//! Before startup initialization, library callers retain the original English strings.
+
+use std::io;
+use std::path::Path;
+use std::sync::OnceLock;
+
+pub use codex_config::ui_language::UiLanguage as Locale;
+
+mod catalog;
+pub use catalog::message;
+pub use catalog::message_for;
+pub use catalog::message_with_count;
+pub use catalog::message_with_count_for;
+pub use catalog::static_message;
+
+/// Explain an automatic fallback without discarding either executable path.
+pub fn daemon_selection_mismatch_warning(
+    mismatch: &codex_app_server_daemon::CliDaemonMismatch,
+) -> String {
+    message(
+        "daemon-auto-selected-mismatch",
+        &[
+            ("cli_path", &mismatch.cli_path.display().to_string()),
+            ("managed_path", &mismatch.managed_path.display().to_string()),
+        ],
+    )
+}
+
+/// The socket identifies the contacted runtime, not the selected package path.
+pub(crate) fn daemon_connection_mismatch_warning(
+    cli_version: &str,
+    server_version: Option<&str>,
+    endpoint: &str,
+) -> String {
+    let unknown = message("status-unknown-version", &[]);
+    let cli_path = std::env::current_exe()
+        .map(|path| path.display().to_string())
+        .unwrap_or_else(|_| unknown.clone());
+    message(
+        "daemon-implicit-version-mismatch",
+        &[
+            ("server", server_version.unwrap_or(&unknown)),
+            ("client", cli_version),
+            ("cli_path", &cli_path),
+            ("endpoint", endpoint),
+        ],
+    )
+}
+
+static LOCALE: OnceLock<Locale> = OnceLock::new();
+
+/// Call before constructing CLI help or TUI views. This never changes configuration files.
+pub fn initialize() -> io::Result<()> {
+    // CLI and TUI startup can both call this in one process. A later global file
+    // edit is for the next process and must not invalidate this launch's locale.
+    if LOCALE.get().is_some() {
+        return Ok(());
+    }
+    let setting = match std::env::var("CODEX_UI_LANGUAGE") {
+        Ok(value) => Some(value),
+        Err(std::env::VarError::NotPresent) => None,
+        Err(std::env::VarError::NotUnicode(_)) => {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "CODEX_UI_LANGUAGE must contain a Unicode language tag such as ko or en",
+            ));
+        }
+    };
+    let home = codex_utils_home_dir::find_codex_home()?;
+    let locale = locale_from_user_settings(home.as_path(), setting.as_deref())?;
+    // A concurrent initializer keeps the first successful selection for this process.
+    let _ = LOCALE.set(locale);
+    Ok(())
+}
+
+fn locale_from_user_settings(
+    home: &Path,
+    environment_override: Option<&str>,
+) -> io::Result<Locale> {
+    if environment_override.is_some() {
+        return Locale::from_setting(environment_override)
+            .map_err(|error| io::Error::new(io::ErrorKind::InvalidInput, error));
+    }
+    codex_config::ui_language::read_user_ui_language(home)
+}
+
+pub fn locale() -> Locale {
+    #[cfg(test)]
+    if let Some(locale) = TEST_LOCALE.with(std::cell::Cell::get) {
+        return locale;
+    }
+    LOCALE.get().copied().unwrap_or(Locale::English)
+}
+
+/// Translate an explicitly selected UI literal, falling back to the supplied original.
+pub fn text(original: &str) -> &str {
+    text_for(locale(), original)
+}
+
+pub fn text_for(locale: Locale, original: &str) -> &str {
+    if locale == Locale::English {
+        return original;
+    }
+    catalog::legacy_text(original).unwrap_or(original)
+}
+
+#[cfg(test)]
+thread_local! {
+    static TEST_LOCALE: std::cell::Cell<Option<Locale>> = const { std::cell::Cell::new(None) };
+}
+
+#[cfg(test)]
+pub(crate) fn with_locale<T>(locale: Locale, f: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Locale>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            TEST_LOCALE.with(|value| value.set(self.0));
+        }
+    }
+    let _restore = Restore(TEST_LOCALE.with(|value| value.replace(Some(locale))));
+    f()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn daemon_connection_mismatch_preserves_runtime_source_and_explicit_guidance() {
+        let endpoint = r"unix://D:\공유 서버\control.sock";
+        let cli = "0.166.0+native-r38.20261106";
+        let server = "0.166.0+native-r36.20261104";
+        for (locale, refused, unknown_path) in [
+            (
+                Locale::English,
+                "Automatic attachment was refused",
+                "does not identify the running server executable path",
+            ),
+            (
+                Locale::Korean,
+                "자동 연결을 거부했습니다",
+                "실행 중인 서버 실행 파일 경로는 확인할 수 없습니다",
+            ),
+        ] {
+            for version in [Some(server), None] {
+                let warning = with_locale(locale, || {
+                    daemon_connection_mismatch_warning(cli, version, endpoint)
+                });
+                for expected in [
+                    endpoint,
+                    cli,
+                    refused,
+                    unknown_path,
+                    "--no-daemon",
+                    "codex app-server daemon update --from-cli --yes --no-force",
+                ] {
+                    assert!(warning.contains(expected), "{warning}");
+                }
+                let unknown = with_locale(locale, || message("status-unknown-version", &[]));
+                assert!(warning.contains(version.unwrap_or(&unknown)), "{warning}");
+                assert!(warning.contains(&std::env::current_exe().unwrap().display().to_string()));
+            }
+        }
+    }
+
+    #[test]
+    fn daemon_selection_mismatch_warning_preserves_paths_and_guidance_in_both_languages() {
+        let mismatch = codex_app_server_daemon::CliDaemonMismatch {
+            cli_path: r"D:\CLI 실행\R37 build\codex.exe".into(),
+            managed_path: r"D:\공유 서버\old package\bin\codex.exe".into(),
+        };
+        for (locale, selected, client, preserved) in [
+            (
+                Locale::English,
+                r"selected shared server executable D:\공유 서버\old package\bin\codex.exe",
+                r"differs from this CLI D:\CLI 실행\R37 build\codex.exe",
+                "the shared installation was preserved",
+            ),
+            (
+                Locale::Korean,
+                r"선택된 공유 서버 실행 파일 D:\공유 서버\old package\bin\codex.exe",
+                r"현재 CLI D:\CLI 실행\R37 build\codex.exe와 다릅니다",
+                "공유 설치본은 보존했습니다",
+            ),
+        ] {
+            let warning = with_locale(locale, || daemon_selection_mismatch_warning(&mismatch));
+            assert!(warning.contains(selected), "{warning}");
+            assert!(warning.contains(client), "{warning}");
+            assert!(warning.contains(preserved), "{warning}");
+            assert!(warning.contains("codex app-server daemon update --from-cli --yes --no-force"));
+        }
+    }
+
+    #[test]
+    fn saved_language_controls_ui_and_environment_override_never_writes_configuration() {
+        use codex_config::ui_language::UiLanguage;
+        let home = tempfile::tempdir().unwrap();
+        assert_eq!(
+            locale_from_user_settings(home.path(), None).unwrap(),
+            Locale::English
+        );
+        for (saved, expected, rendered) in [
+            (UiLanguage::Korean, Locale::Korean, "작업 중"),
+            (UiLanguage::English, Locale::English, "Working"),
+        ] {
+            codex_config::ui_language::write_user_ui_language(home.path(), saved).unwrap();
+            assert_eq!(
+                locale_from_user_settings(home.path(), None).unwrap(),
+                expected
+            );
+            assert_eq!(
+                text_for(
+                    locale_from_user_settings(home.path(), None).unwrap(),
+                    "Working"
+                ),
+                rendered
+            );
+            let path = home
+                .path()
+                .join(codex_config::ui_language::CLIENT_PREFERENCES_FILE);
+            let bytes = std::fs::read(&path).unwrap();
+            assert_eq!(
+                locale_from_user_settings(home.path(), Some("en")).unwrap(),
+                Locale::English
+            );
+            assert_eq!(
+                locale_from_user_settings(home.path(), Some("ko")).unwrap(),
+                Locale::Korean
+            );
+            assert!(locale_from_user_settings(home.path(), Some("kr")).is_err());
+            assert_eq!(std::fs::read(&path).unwrap(), bytes);
+        }
+    }
+
+    #[test]
+    fn language_selection_defaults_to_english_and_rejects_unknown_values() {
+        assert_eq!(Locale::from_setting(None), Ok(Locale::English));
+        assert_eq!(Locale::from_setting(Some("ko")), Ok(Locale::Korean));
+        assert_eq!(Locale::from_setting(Some("en")), Ok(Locale::English));
+        assert_eq!(Locale::from_setting(Some("KO")), Ok(Locale::Korean));
+        assert_eq!(Locale::from_setting(Some("ko-KR")), Ok(Locale::Korean));
+        assert_eq!(Locale::from_setting(Some("en-US")), Ok(Locale::English));
+        for invalid in ["", "kr", "ja", "ko_kr"] {
+            assert!(Locale::from_setting(Some(invalid)).is_err());
+        }
+    }
+
+    #[test]
+    fn english_and_unknown_text_preserve_the_original() {
+        assert_eq!(text_for(Locale::Korean, "Working"), "작업 중");
+        assert_eq!(text_for(Locale::English, "Working"), "Working");
+        for token in [
+            "/model",
+            "read-only",
+            "model",
+            "request_id",
+            "사용자 원문",
+            "untranslated UI",
+        ] {
+            assert_eq!(text_for(Locale::Korean, token), token);
+        }
+    }
+
+    #[test]
+    fn memory_scope_labels_translate_without_changing_commands_or_paths() {
+        assert_eq!(text_for(Locale::Korean, "Memory scope:"), "메모리 범위:");
+        assert_eq!(text_for(Locale::Korean, "project"), "프로젝트");
+        assert_eq!(text_for(Locale::English, "project"), "project");
+        for opaque in [
+            "/memory view",
+            "thread/memory/note/add",
+            "project_memories/key/memories_v2",
+        ] {
+            assert_eq!(text_for(Locale::Korean, opaque), opaque);
+        }
+    }
+
+    #[test]
+    fn scoped_language_restores_after_rendering() {
+        with_locale(Locale::English, || {
+            with_locale(Locale::Korean, || assert_eq!(text("Working"), "작업 중"));
+            assert_eq!(text("Working"), "Working");
+        });
+    }
+}
diff --git a/codex-rs/tui/src/i18n/catalog.rs b/codex-rs/tui/src/i18n/catalog.rs
new file mode 100644
index 000000000..96493c422
--- /dev/null
+++ b/codex-rs/tui/src/i18n/catalog.rs
@@ -0,0 +1,497 @@
+//! Fluent catalogs for application-owned UI messages. Argument values are opaque.
+
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+use fluent_bundle::FluentArgs;
+use fluent_bundle::FluentResource;
+use fluent_bundle::concurrent::FluentBundle;
+use fluent_syntax::ast;
+use unic_langid::LanguageIdentifier;
+
+use super::Locale;
+
+type Sources<'a> = &'a [(&'a str, &'a str)];
+
+const EN: Sources<'static> = &[
+    ("core", include_str!("../../locales/en/core.ftl")),
+    ("legacy", include_str!("../../locales/en/legacy.ftl")),
+    ("cloud", include_str!("../../locales/en/cloud.ftl")),
+    ("dialogs", include_str!("../../locales/en/dialogs.ftl")),
+    ("status", include_str!("../../locales/en/status.ftl")),
+    ("cli", include_str!("../../locales/en/cli.ftl")),
+    ("picker", include_str!("../../locales/en/picker.ftl")),
+    ("controls", include_str!("../../locales/en/controls.ftl")),
+    (
+        "r36-agents",
+        include_str!("../../locales/en/r36-agents.ftl"),
+    ),
+    ("r36-ci", include_str!("../../locales/en/r36-ci.ftl")),
+    ("r36-cleanup", include_str!("../../locales/en/r36-cleanup.ftl")),
+];
+const KO: Sources<'static> = &[
+    ("core", include_str!("../../locales/ko/core.ftl")),
+    ("legacy", include_str!("../../locales/ko/legacy.ftl")),
+    ("cloud", include_str!("../../locales/ko/cloud.ftl")),
+    ("dialogs", include_str!("../../locales/ko/dialogs.ftl")),
+    ("status", include_str!("../../locales/ko/status.ftl")),
+    ("cli", include_str!("../../locales/ko/cli.ftl")),
+    ("picker", include_str!("../../locales/ko/picker.ftl")),
+    ("controls", include_str!("../../locales/ko/controls.ftl")),
+    (
+        "r36-agents",
+        include_str!("../../locales/ko/r36-agents.ftl"),
+    ),
+    ("r36-ci", include_str!("../../locales/ko/r36-ci.ftl")),
+    ("r36-cleanup", include_str!("../../locales/ko/r36-cleanup.ftl")),
+];
+
+struct Catalog {
+    bundle: FluentBundle<FluentResource>,
+    variables: BTreeMap<String, BTreeSet<String>>,
+    static_messages: BTreeMap<String, String>,
+    problems: Vec<String>,
+}
+
+impl Catalog {
+    fn new(language: &str, sources: Sources<'_>) -> Self {
+        let mut bundle = FluentBundle::new_concurrent(vec![
+            language.parse::<LanguageIdentifier>().unwrap_or_default(),
+        ]);
+        // These terminal UI strings already preserve the caller's layout. Do not
+        // add invisible direction-isolation characters around opaque arguments.
+        bundle.set_use_isolating(false);
+        let mut variables = BTreeMap::new();
+        let mut problems = Vec::new();
+        for (namespace, source) in sources {
+            let resource = match FluentResource::try_new((*source).to_owned()) {
+                Ok(resource) => resource,
+                Err((resource, errors)) => {
+                    problems.push(format!("{language}/{namespace}: {errors:?}"));
+                    resource
+                }
+            };
+            for entry in resource.entries() {
+                let (id, value, attributes) = match entry {
+                    ast::Entry::Message(message) => (
+                        message.id.name.to_owned(),
+                        message.value.as_ref(),
+                        &message.attributes,
+                    ),
+                    ast::Entry::Term(term) => (
+                        format!("-{}", term.id.name),
+                        Some(&term.value),
+                        &term.attributes,
+                    ),
+                    _ => continue,
+                };
+                let mut names = BTreeSet::new();
+                if let Some(value) = value {
+                    pattern_variables(value, &mut names);
+                    if value.elements.is_empty() {
+                        problems.push(format!("{language}/{namespace}: empty {id}"));
+                    }
+                } else if attributes.is_empty() {
+                    problems.push(format!("{language}/{namespace}: empty {id}"));
+                }
+                if variables.insert(id.clone(), names).is_some() {
+                    problems.push(format!("{language}/{namespace}: duplicate {id}"));
+                }
+                for attribute in attributes {
+                    let mut names = BTreeSet::new();
+                    pattern_variables(&attribute.value, &mut names);
+                    let attribute_id = format!("{id}.{}", attribute.id.name);
+                    if variables.insert(attribute_id.clone(), names).is_some() {
+                        problems.push(format!("{language}/{namespace}: duplicate {attribute_id}"));
+                    }
+                }
+            }
+            if let Err(errors) = bundle.add_resource(resource) {
+                problems.push(format!("{language}/{namespace}: {errors:?}"));
+            }
+        }
+        let mut catalog = Self {
+            bundle,
+            variables,
+            static_messages: BTreeMap::new(),
+            problems,
+        };
+        for (id, names) in &catalog.variables {
+            if names.is_empty()
+                && let Some(rendered) = catalog.render(id, &FluentArgs::new())
+            {
+                catalog.static_messages.insert(id.clone(), rendered);
+            }
+        }
+        catalog
+    }
+
+    fn render(&self, id: &str, args: &FluentArgs<'_>) -> Option<String> {
+        let message = self.bundle.get_message(id)?;
+        let value = message.value()?;
+        let mut errors = Vec::new();
+        let rendered = self.bundle.format_pattern(value, Some(args), &mut errors);
+        errors.is_empty().then(|| rendered.into_owned())
+    }
+}
+
+struct Catalogs {
+    english: Catalog,
+    korean: Catalog,
+    legacy: HashMap<String, String>,
+}
+
+impl Catalogs {
+    fn new(english: Sources<'_>, korean: Sources<'_>) -> Self {
+        let english = Catalog::new("en", english);
+        let korean = Catalog::new("ko", korean);
+        let mut legacy = HashMap::new();
+        for (id, original) in english
+            .static_messages
+            .iter()
+            .filter(|(id, _)| id.starts_with("legacy-"))
+        {
+            let translated = korean.static_messages.get(id).unwrap_or(original);
+            legacy.insert(original.clone(), translated.clone());
+        }
+        Self {
+            english,
+            korean,
+            legacy,
+        }
+    }
+
+    fn render(&self, locale: Locale, id: &str, args: &FluentArgs<'_>) -> String {
+        if locale == Locale::Korean
+            && let Some(rendered) = self.korean.render(id, args).filter(|text| !text.is_empty())
+        {
+            return rendered;
+        }
+        self.english
+            .render(id, args)
+            .filter(|text| !text.is_empty())
+            .unwrap_or_else(|| {
+                // A catalog/call-site defect must not crash a running UI. The ID is
+                // a stable last resort; never log user/server argument values.
+                tracing::warn!(
+                    message_id = id,
+                    "UI message unavailable or invalid arguments"
+                );
+                id.to_owned()
+            })
+    }
+
+    fn static_message(&self, locale: Locale, id: &'static str) -> &str {
+        let localized = if locale == Locale::Korean {
+            self.korean.static_messages.get(id)
+        } else {
+            None
+        };
+        localized
+            .filter(|value| !value.is_empty())
+            .or_else(|| {
+                self.english
+                    .static_messages
+                    .get(id)
+                    .filter(|value| !value.is_empty())
+            })
+            .map(String::as_str)
+            .unwrap_or_else(|| {
+                tracing::warn!(
+                    message_id = id,
+                    "Static UI message unavailable or requires arguments"
+                );
+                id
+            })
+    }
+
+    fn problems(&self) -> Vec<String> {
+        let mut problems = self.english.problems.clone();
+        problems.extend(self.korean.problems.iter().cloned());
+        for (id, variables) in &self.english.variables {
+            match self.korean.variables.get(id) {
+                None => problems.push(format!("ko: missing {id}")),
+                Some(other) if variables != other => {
+                    problems.push(format!(
+                        "{id}: argument mismatch {variables:?} vs {other:?}"
+                    ));
+                }
+                Some(_) => {}
+            }
+        }
+        for id in self.korean.variables.keys() {
+            if !self.english.variables.contains_key(id) {
+                problems.push(format!("en: missing {id}"));
+            }
+        }
+        for (language, catalog) in [("en", &self.english), ("ko", &self.korean)] {
+            for (id, variables) in &catalog.variables {
+                if variables.is_empty()
+                    && catalog
+                        .render(id, &FluentArgs::new())
+                        .is_some_and(|text| text.is_empty())
+                {
+                    problems.push(format!("{language}: empty {id}"));
+                }
+            }
+        }
+        problems
+    }
+}
+
+fn catalogs() -> &'static Catalogs {
+    static CATALOGS: OnceLock<Catalogs> = OnceLock::new();
+    CATALOGS.get_or_init(|| {
+        let catalogs = Catalogs::new(EN, KO);
+        for problem in catalogs.problems() {
+            tracing::warn!(%problem, "Invalid UI catalog; English fallback remains available");
+        }
+        catalogs
+    })
+}
+
+pub(super) fn legacy_text(original: &str) -> Option<&'static str> {
+    catalogs().legacy.get(original).map(String::as_str)
+}
+
+/// Format an application-owned message with named, opaque string arguments.
+pub fn message(id: &str, args: &[(&str, &str)]) -> String {
+    message_for(super::locale(), id, args)
+}
+
+/// Missing/broken localized messages fall back to English, then to the stable ID.
+pub fn message_for(locale: Locale, id: &str, args: &[(&str, &str)]) -> String {
+    let args: FluentArgs<'_> = args.iter().map(|(name, value)| (*name, *value)).collect();
+    catalogs().render(locale, id, &args)
+}
+
+/// Borrow a cached, argument-free message for APIs that require a static label.
+/// Messages requiring arguments and unknown IDs fall back to the static ID.
+pub fn static_message(id: &'static str) -> &'static str {
+    catalogs().static_message(super::locale(), id)
+}
+
+/// Like `message`, but `$count` is numeric so Fluent plural selectors work.
+pub fn message_with_count(id: &str, args: &[(&str, &str)], count: i64) -> String {
+    message_with_count_for(super::locale(), id, args, count)
+}
+
+pub fn message_with_count_for(
+    locale: Locale,
+    id: &str,
+    args: &[(&str, &str)],
+    count: i64,
+) -> String {
+    let mut args: FluentArgs<'_> = args.iter().map(|(name, value)| (*name, *value)).collect();
+    args.set("count", count);
+    catalogs().render(locale, id, &args)
+}
+
+fn pattern_variables(pattern: &ast::Pattern<&str>, names: &mut BTreeSet<String>) {
+    for element in &pattern.elements {
+        if let ast::PatternElement::Placeable { expression } = element {
+            expression_variables(expression, names);
+        }
+    }
+}
+
+fn expression_variables(expression: &ast::Expression<&str>, names: &mut BTreeSet<String>) {
+    match expression {
+        ast::Expression::Inline(inline) => inline_variables(inline, names),
+        ast::Expression::Select { selector, variants } => {
+            inline_variables(selector, names);
+            for variant in variants {
+                pattern_variables(&variant.value, names);
+            }
+        }
+    }
+}
+
+fn inline_variables(inline: &ast::InlineExpression<&str>, names: &mut BTreeSet<String>) {
+    match inline {
+        ast::InlineExpression::VariableReference { id } => {
+            names.insert(id.name.to_owned());
+        }
+        ast::InlineExpression::Placeable { expression } => expression_variables(expression, names),
+        ast::InlineExpression::FunctionReference { arguments, .. }
+        | ast::InlineExpression::TermReference {
+            arguments: Some(arguments),
+            ..
+        } => {
+            for argument in &arguments.positional {
+                inline_variables(argument, names);
+            }
+            for argument in &arguments.named {
+                inline_variables(&argument.value, names);
+            }
+        }
+        _ => {}
+    }
+}
