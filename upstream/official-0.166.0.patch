+    drop(registry);
+    let compact_context = root.thread.session.new_default_turn().await;
+    assert!(
+        root.thread
+            .session
+            .start_task_with_reservation(
+                compact_context,
+                Vec::new(),
+                HeldTask {
+                    kind: TaskKind::Compact,
+                    finish: Arc::new(Notify::new()),
