+                Some(codex_agent_graph_store::ThreadSpawnEdgeStatus::Closed)
+            )
+            .await
+            .unwrap(),
+        vec![child_id]
+    );
+    assert!(manager.get_thread(child_id).await.is_err());
+    assert!(stored(&manager, parent_id).await);
+}
