+
+    fn server_error(method: &str, code: i64, message: &str) -> TypedRequestError {
+        TypedRequestError::Server {
+            method: method.into(),
+            source: JSONRPCErrorError {
+                code,
+                message: message.into(),
+                data: None,
+            },
+        }
+    }
