+            );
+            assert_thread_not_loaded(&harness.manager, child.thread_id).await;
+            assert_thread_not_loaded(&harness.manager, grandchild.thread_id).await;
+        }
+        let _ = harness
+            .manager
+            .shutdown_all_threads_bounded(Duration::from_secs(5))
+            .await;
+    }
+}
