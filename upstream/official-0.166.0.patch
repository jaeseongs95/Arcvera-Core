+        ))]);
+        let response = codex_client::StreamResponse {
+            status: http::StatusCode::OK,
+            headers: http::HeaderMap::new(),
+            bytes: Box::pin(bytes),
+        };
+        let mut stream = spawn_response_stream_observed(
+            response,
+            std::time::Duration::from_secs(1),
+            None,
+            None,
+            observation,
