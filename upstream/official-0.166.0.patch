+    .unwrap();
+    let selected = daemon(&home);
+    settings.save(&selected.settings_file).await.unwrap();
+    let old_selection = home
+        .join("packages/app-server-daemon/current")
+        .canonicalize()
+        .unwrap();
+    let ready = temp.path().join("ready");
+    let fixture = format!(
+        "#!/bin/sh\ncase \"$*\" in *--help*) exit 1;; esac\nif [ \"$1\" = --version ]; then echo 'codex 0.152.0'; exit 0; fi\ntrap '' TERM HUP\ntouch '{}'\nwhile :; do sleep 1; done\n",
