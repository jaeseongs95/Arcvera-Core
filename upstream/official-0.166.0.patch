+
+    fn scope() -> Scope {
+        Scope {
+            backend_id: UuidText::parse("11111111-2222-4333-8444-555555555555").unwrap(),
+            backend_epoch: DecimalU64::new(7),
+            thread_id: UuidText::parse("12345678-1234-4567-8123-123456789abc").unwrap(),
+        }
