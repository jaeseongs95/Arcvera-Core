+            .into_iter()
+            .flatten()
+            {
+                let value = value.to_string();
+                assert!(
+                    help_message_id(&value).is_some()
+                        || value.chars().any(|c| ('가'..='힣').contains(&c)),
+                    "uncataloged {path}: {value:?}"
