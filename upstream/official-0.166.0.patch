+    assert_eq!(turn_ids(&large), vec!["large"]);
+    assert_eq!(large.turns[0].items.len(), 2);
+    let next = store
+        .list_turns(turn_params(
+            thread_id,
+            large.next_cursor,
+            100,
+            SortDirection::Asc,
+            StoredTurnItemsView::Summary,
+        ))
+        .await
+        .unwrap();
+    assert_eq!(turn_ids(&next), vec!["small"]);
+    let reverse = store
+        .list_turns(turn_params(
