+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+if (-not $UpdaterPath) { $UpdaterPath = Join-Path $PSScriptRoot 'update.ps1' }
+$UpdaterPath = [IO.Path]::GetFullPath($UpdaterPath)
+$WorkRoot = [IO.Path]::GetFullPath($WorkRoot)
