+    let unrelated_snapshot: ThreadSubagentsListResponse = app
+        .request(|request_id| ClientRequest::ThreadSubagentsList {
+            request_id,
+            params: ThreadSubagentsListParams {
+                parent_thread_id: unrelated_id.clone(),
+                cursor: None,
+                limit: None,
+                reconcile_request_id: None,
+            },
+        })
+        .await?;
