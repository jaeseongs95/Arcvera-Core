+    let explain = sqlx::QueryBuilder::<sqlx::Sqlite>::new("EXPLAIN ")
+        .push(SUMMARY_ITEMS_QUERY)
+        .build()
+        .bind(thread_id.to_string())
+        .bind("turn")
+        .bind(1_i64)
+        .bind(None::<i64>)
+        .bind(None::<i64>)
+        .bind("first")
+        .bind(None::<String>)
+        .fetch_all(db)
+        .await
