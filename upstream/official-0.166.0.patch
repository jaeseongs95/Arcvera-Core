+                owners: Arc::downgrade(&owners),
+                pool: Weak::new(),
+            });
+            let first = ConnectionLease {
+                entry: Arc::clone(&entry),
+                owner: Mutex::new(Some(Arc::clone(&owners))),
+                cancellation: CancellationToken::new(),
+                slot: Arc::default(),
+            };
+            let last_slot = Arc::new(ConnectionSlot::default());
+            let last = ConnectionLease {
+                entry: Arc::clone(&entry),
+                owner: Mutex::new(Some(owners)),
+                cancellation: CancellationToken::new(),
+                slot: Arc::clone(&last_slot),
+            };
+            assert!(
+                first.release().is_none(),
+                "another chat still owns the connection"
+            );
+            assert!(!entry.cancellation.is_cancelled());
+            assert_eq!(cleanups.load(Ordering::SeqCst), 0);
+            assert!(last.release().is_some());
+            assert!(entry.cancellation.is_cancelled());
+            let waiter = {
+                let slot = Arc::clone(&last_slot);
+                tokio::spawn(async move { slot.wait_for_shutdown().await })
+            };
