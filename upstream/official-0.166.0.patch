+                limit: Some(100),
+                reconcile_request_id: None,
+            },
+        })
+        .await?;
+    assert_eq!(snapshot.parent_thread_id, parent_id);
+    assert!(Uuid::parse_str(&snapshot.parent_runtime_id).is_ok());
+    assert!(snapshot.agents.is_empty());
