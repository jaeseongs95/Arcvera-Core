+        let error = "backend://opaque/한글-e\u{301} { $error }";
+        for (locale, pending, busy, confirmed, unconfirmed, error_prefix) in [
+            (
+                Locale::English,
+                "Copying link…",
+                "Clipboard busy; try again",
+                "Copied link to clipboard",
+                "Copy requested; check your clipboard",
+                "Could not copy link: ",
+            ),
