new file mode 100644
index 000000000..dabfdb596
--- /dev/null
+++ b/codex-rs/tui/src/app/diagnostics_control.rs
@@ -0,0 +1,89 @@
+//! Explicit local diagnostic controls; filesystem work never runs on the UI task.
+
+use crate::i18n::Locale;
+use codex_diagnostics::settings_control;
+use serde_json::Value;
+use serde_json::json;
+use std::path::PathBuf;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) enum Action {
+    LoggingStatus,
+    LoggingSet { enabled: bool },
+    CacheDiagnosticsStatus,
+    CacheDiagnosticsSet { response: bool, wire: bool },
+}
+
+pub(super) async fn handle(action: Action) -> Result<Value, String> {
+    let locale = crate::i18n::locale();
+    // The local client owns these diagnostics, including when its backend is remote.
+    let home = codex_utils_home_dir::find_codex_home().map_err(|error| {
+        crate::i18n::message_for(
+            locale,
+            "diagnostics-home-failed",
+            &[("error", &error.to_string())],
+        )
+    })?;
+    control_at_home(action, home.to_path_buf(), locale).await
+}
+
+async fn control_at_home(action: Action, home: PathBuf, locale: Locale) -> Result<Value, String> {
+    if matches!(
+        action,
+        Action::CacheDiagnosticsSet {
+            response: false,
+            wire: true
+        }
+    ) {
+        return Err(crate::i18n::message_for(
+            locale,
+            "diagnostics-cache-wire-requires-response",
+            &[],
+        ));
+    }
+    let mutation = matches!(
+        action,
+        Action::LoggingSet { .. } | Action::CacheDiagnosticsSet { .. }
+    );
+    let status = tokio::task::spawn_blocking(move || match action {
+        Action::LoggingStatus | Action::CacheDiagnosticsStatus => settings_control::status(&home),
+        Action::LoggingSet { enabled } => {
+            settings_control::update(&home, settings_control::Update::Logging { enabled })
+        }
+        Action::CacheDiagnosticsSet { response, wire } => {
+            settings_control::update(&home, settings_control::Update::Cache { response, wire })
+        }
+    })
+    .await
+    .map_err(|error| {
+        crate::i18n::message_for(
+            locale,
+            "diagnostics-operation-unconfirmed",
+            &[("error", &error.to_string())],
+        )
+    })?
+    .map_err(|error| {
+        if error.kind() == std::io::ErrorKind::WouldBlock {
+            crate::i18n::message_for(locale, "diagnostics-settings-busy", &[])
+        } else {
+            crate::i18n::message_for(
+                locale,
+                "diagnostics-operation-failed",
+                &[("error", &error.to_string())],
+            )
+        }
+    })?;
+    Ok(json!({
+        "scope": "local_client",
+        "settings": status,
+        "message": crate::i18n::message_for(
+            locale,
+            if mutation { "diagnostics-saved-next-launch" } else { "diagnostics-status" },
+            &[],
+        ),
+    }))
+}
+
+#[cfg(test)]
+#[path = "diagnostics_control_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/app/diagnostics_control_tests.rs b/codex-rs/tui/src/app/diagnostics_control_tests.rs
new file mode 100644
index 000000000..6a90dc8c3
--- /dev/null
+++ b/codex-rs/tui/src/app/diagnostics_control_tests.rs
@@ -0,0 +1,77 @@
+use super::*;
+
+#[tokio::test]
+async fn diagnostic_actions_report_saved_settings_without_changing_runtime_or_other_settings() {
+    for locale in [Locale::English, Locale::Korean] {
+        let home = tempfile::tempdir().unwrap();
+        let current = codex_diagnostics::cache_diagnostics::initialized_process_mode();
+        let initial = control_at_home(Action::LoggingStatus, home.path().to_path_buf(), locale)
+            .await
+            .unwrap();
+        assert_eq!(initial["settings"]["saved_logging"]["enabled"], false);
+        assert_eq!(std::fs::read_dir(home.path()).unwrap().count(), 0);
+        let enabled = control_at_home(
+            Action::LoggingSet { enabled: true },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(enabled["settings"]["saved_logging"]["enabled"], true);
+        assert_eq!(enabled["settings"]["saved_cache"]["response"], false);
+        assert_eq!(
+            enabled["settings"]["next_process_mode_if_environment_unchanged"]["response_enabled"],
+            false
+        );
+        let cache = control_at_home(
+            Action::CacheDiagnosticsSet {
+                response: true,
+                wire: true,
+            },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(cache["settings"]["saved_cache"]["wire"], true);
+        assert_eq!(
+            cache["settings"]["next_process_mode_if_environment_unchanged"]["wire_enabled"],
+            true
+        );
+        assert_eq!(
+            codex_diagnostics::cache_diagnostics::initialized_process_mode(),
+            current
+        );
+        assert!(cache["message"].as_str().unwrap().contains(match locale {
+            Locale::English => "next launch",
+            Locale::Korean => "다음 실행",
+        }));
+        let before = std::fs::read(home.path().join("cli-cache-diagnostics.toml")).unwrap();
+        let error = control_at_home(
+            Action::CacheDiagnosticsSet {
+                response: false,
+                wire: true,
+            },
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap_err();
+        assert!(error.contains(match locale {
+            Locale::English => "requires response",
+            Locale::Korean => "응답 관측",
+        }));
+        assert_eq!(
+            std::fs::read(home.path().join("cli-cache-diagnostics.toml")).unwrap(),
+            before
+        );
+        let readback = control_at_home(
+            Action::CacheDiagnosticsStatus,
+            home.path().to_path_buf(),
+            locale,
+        )
+        .await
+        .unwrap();
+        assert_eq!(readback["settings"]["saved_cache"]["wire"], true);
+    }
+}
